<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dragonwilds-only resources. Merged by DragonwildsShellView, so they load only while Dragonwilds is active. -->
    <SolidColorBrush x:Key="DwGoldBrush" Color="#C9A24A" />
    <SolidColorBrush x:Key="DwGoldBrightBrush" Color="#EBD08A" />
    <SolidColorBrush x:Key="DwFrameBrush" Color="#7A5E2E" />
    <SolidColorBrush x:Key="DwFrameInnerBrush" Color="#3E3020" />
    <SolidColorBrush x:Key="DwMagicBrush" Color="#B266FF" />
    <LinearGradientBrush x:Key="DwGoldTextBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F6E3A6" Offset="0" />
        <GradientStop Color="#D9B261" Offset="0.55" />
        <GradientStop Color="#B4873A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DwGoldFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EED593" Offset="0" />
        <GradientStop Color="#CFA552" Offset="0.6" />
        <GradientStop Color="#A9802F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DwGoldFillHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7E4AE" Offset="0" />
        <GradientStop Color="#DDB868" Offset="0.6" />
        <GradientStop Color="#B98E3B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DwCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A1F1C" Offset="0" />
        <GradientStop Color="#1B1413" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DwSelectedCardBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3B2546" Offset="0" />
        <GradientStop Color="#261B22" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DwFadeLeftBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00C9A24A" Offset="0" />
        <GradientStop Color="#C9A24A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DwFadeRightBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C9A24A" Offset="0" />
        <GradientStop Color="#00C9A24A" Offset="1" />
    </LinearGradientBrush>
    <Geometry x:Key="DwDiamondGeometry">M4,0 L8,4 L4,8 L0,4 Z</Geometry>
    <!-- Original rune-circle emblem: two rings, a hexagram and four cardinal diamonds. -->
    <GeometryGroup x:Key="DwEmblemGeometry">
        <EllipseGeometry Center="100,100" RadiusX="96" RadiusY="96" />
        <EllipseGeometry Center="100,100" RadiusX="78" RadiusY="78" />
        <EllipseGeometry Center="100,100" RadiusX="22" RadiusY="22" />
        <PathGeometry Figures="M100,30 L160.6,135 L39.4,135 Z M100,170 L39.4,65 L160.6,65 Z" />
        <PathGeometry Figures="M100,0 L106,10 L100,20 L94,10 Z M100,180 L106,190 L100,200 L94,190 Z M0,100 L10,94 L20,100 L10,106 Z M180,100 L190,94 L200,100 L190,106 Z" />
    </GeometryGroup>

    <Style x:Key="DwHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DwGoldBrightBrush}" />
    </Style>

    <Style x:Key="DwMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Double gold rule with diamond corners, as on the official artwork. -->
    <Style x:Key="DwFrame" TargetType="ContentControl">
        <Setter Property="Background" Value="{StaticResource DwCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DwFrameBrush}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="3">
                            <Border BorderBrush="{StaticResource DwFrameInnerBrush}" BorderThickness="1" CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Border>
                        <Path Data="{StaticResource DwDiamondGeometry}" Fill="{TemplateBinding BorderBrush}" Width="8" Height="8"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0" />
                        <Path Data="{StaticResource DwDiamondGeometry}" Fill="{TemplateBinding BorderBrush}" Width="8" Height="8"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
                        <Path Data="{StaticResource DwDiamondGeometry}" Fill="{TemplateBinding BorderBrush}" Width="8" Height="8"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3" />
                        <Path Data="{StaticResource DwDiamondGeometry}" Fill="{TemplateBinding BorderBrush}" Width="8" Height="8"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Line, diamond, optional title, diamond, line. -->
    <Style x:Key="DwOrnamentDivider" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Height="1" Fill="{StaticResource DwFadeLeftBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                            <Path Data="{StaticResource DwDiamondGeometry}" Fill="{StaticResource DwGoldBrush}" Width="7" Height="7" VerticalAlignment="Center" />
                            <ContentPresenter Margin="10,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource DwDiamondGeometry}" Fill="{StaticResource DwGoldBrush}" Width="7" Height="7" VerticalAlignment="Center" />
                        </StackPanel>
                        <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource DwFadeRightBrush}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DwPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DwGoldFillBrush}" />
        <Setter Property="BorderBrush" Value="#8A6A2C" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DwGoldFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DwPlayButton" TargetType="Button" BasedOn="{StaticResource DwPrimaryButton}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Padding" Value="28,8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#E0B860" BlurRadius="22" ShadowDepth="0" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DwSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#1E1614" />
        <Setter Property="BorderBrush" Value="{StaticResource DwFrameBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2A1F1B" />
                <Setter Property="BorderBrush" Value="{StaticResource DwGoldBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PressedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DwLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DwGoldBrightBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DwGameSwitch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Margin="0,0,18,0">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,6" />
                        <Rectangle x:Name="Underline" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource DwGoldBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DwGoldBrightBrush}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DwPill" TargetType="Border">
        <Setter Property="Background" Value="#261D1A" />
        <Setter Property="BorderBrush" Value="{StaticResource DwFrameInnerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
</ResourceDictionary>
