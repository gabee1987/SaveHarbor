<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SaveHarbor.App.ViewModels">
    <Geometry x:Key="SkinPcGeometry">M1,1 H17 V11 H1 Z M6,14 H12 M9,11 V14</Geometry>
    <Geometry x:Key="SkinCloudGeometry">M5,13 H14 A3.5,3.5 0 0 0 14,6 A5,5 0 0 0 4.5,6.5 A3.3,3.3 0 0 0 5,13 Z</Geometry>

    <!-- One side of the PC-versus-cloud comparison. Tag is true when this side holds the newer copy; both sides turn
         red when both changed. -->
    <Style x:Key="SkinSideCard" TargetType="Border">
        <Setter Property="Background" Value="#80181310" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkinRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,11,12,10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SkinGoldBrightBrush}" />
                <Setter Property="Background" Value="#A02A2216" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#E0B860" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSyncAdvice.BothChanged}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sync tones (SyncTone on the DataContext): how a world's local copy relates to the shared one. -->
    <Style x:Key="SkinToneBorder" TargetType="Border">
        <Setter Property="Background" Value="#99201915" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkinRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Good}">
                <Setter Property="BorderBrush" Value="{DynamicResource ToneSuccessBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ToneSuccessBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Info}">
                <Setter Property="BorderBrush" Value="{DynamicResource ToneInfoBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ToneInfoBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Warning}">
                <Setter Property="BorderBrush" Value="{DynamicResource ToneWarnBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ToneWarnBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Danger}">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Background" Value="#3A1C17" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SkinToneText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Good}">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Info}">
                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Warning}">
                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Danger}">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The comparison's middle icon, picked by SyncAdvice.Direction and drawn in its tone: a check when both copies
         match, an arrow towards the side that is behind, a fork when both changed, a lock while a friend plays,
         a warning when blocked, a question mark when the cloud was not checked. Drawn on a 24 x 24 grid. -->
    <Geometry x:Key="SyncSameGeometry">M6.5,12.5 L10.5,16.5 L17.5,8</Geometry>
    <Geometry x:Key="SyncLocalAheadGeometry">M4,12 H19 M14,7 L19,12 L14,17</Geometry>
    <Geometry x:Key="SyncCloudAheadGeometry">M20,12 H5 M10,7 L5,12 L10,17</Geometry>
    <Geometry x:Key="SyncDivergedGeometry">M3.5,12 H8 C11,12 11,6.5 14.5,6.5 H20 M8,12 C11,12 11,17.5 14.5,17.5 H20 M17.5,4 L20,6.5 L17.5,9 M17.5,15 L20,17.5 L17.5,20</Geometry>
    <Geometry x:Key="SyncInUseGeometry">M7,11 H17 V19.5 H7 Z M9.5,11 V8.5 A2.5,2.5 0 0 1 14.5,8.5 V11 M12,14.3 V16.2</Geometry>
    <Geometry x:Key="SyncBlockedGeometry">M12,4 L20.5,19 H3.5 Z M12,9.8 V13.6 M12,16.3 V16.4</Geometry>
    <Geometry x:Key="SyncFreeGeometry">M7,11 H17 V19.5 H7 Z M9.5,11 V8.5 A2.5,2.5 0 0 1 14.4,7.8 M12,14.3 V16.2</Geometry>
    <Geometry x:Key="SyncUnknownGeometry">M9.3,9.2 A2.8,2.8 0 1 1 13.3,11.7 C12.5,12.2 12,12.8 12,13.9 M12,16.9 V17</Geometry>

    <Style x:Key="SkinSyncIcon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
            </Setter.Value>
        </Setter>
        <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Data" Value="{StaticResource SyncUnknownGeometry}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Direction}" Value="=">
                <Setter Property="Data" Value="{StaticResource SyncSameGeometry}" />
                <Setter Property="StrokeThickness" Value="2.4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Direction}" Value="→">
                <Setter Property="Data" Value="{StaticResource SyncLocalAheadGeometry}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Direction}" Value="←">
                <Setter Property="Data" Value="{StaticResource SyncCloudAheadGeometry}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Direction}" Value="≠">
                <Setter Property="Data" Value="{StaticResource SyncDivergedGeometry}" />
                <Setter Property="StrokeThickness" Value="1.8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Direction}" Value="…">
                <Setter Property="Data" Value="{StaticResource SyncInUseGeometry}" />
                <Setter Property="StrokeThickness" Value="1.8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Direction}" Value="lock">
                <Setter Property="Data" Value="{StaticResource SyncInUseGeometry}" />
                <Setter Property="StrokeThickness" Value="1.8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Direction}" Value="unlock">
                <Setter Property="Data" Value="{StaticResource SyncFreeGeometry}" />
                <Setter Property="StrokeThickness" Value="1.8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Direction}" Value="!">
                <Setter Property="Data" Value="{StaticResource SyncBlockedGeometry}" />
                <Setter Property="StrokeThickness" Value="1.8" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Good}">
                <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Info}">
                <Setter Property="Stroke" Value="{DynamicResource InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Warning}">
                <Setter Property="Stroke" Value="{DynamicResource WarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Danger}">
                <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Shows its content only while there is some. -->
    <Style x:Key="SkinOptionalContent" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small badge for a SyncBadge (Text, Tone). -->
    <Style x:Key="SkinSyncBadge" TargetType="ContentControl" BasedOn="{StaticResource SkinOptionalContent}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Style="{StaticResource SkinToneBorder}" Padding="7,1">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource SkinToneText}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
