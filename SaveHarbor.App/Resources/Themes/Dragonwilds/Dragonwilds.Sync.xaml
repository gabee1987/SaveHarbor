<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SaveHarbor.App.ViewModels">
    <Geometry x:Key="DwPcGeometry">M1,1 H17 V11 H1 Z M6,14 H12 M9,11 V14</Geometry>
    <Geometry x:Key="DwCloudGeometry">M5,13 H14 A3.5,3.5 0 0 0 14,6 A5,5 0 0 0 4.5,6.5 A3.3,3.3 0 0 0 5,13 Z</Geometry>

    <!-- One side of the PC-versus-cloud comparison. Tag is true when this side holds the newer copy; both sides turn
         red when both changed. -->
    <Style x:Key="DwSideCard" TargetType="Border">
        <Setter Property="Background" Value="#80181310" />
        <Setter Property="BorderBrush" Value="{DynamicResource DwRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,11,12,10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DwGoldBrightBrush}" />
                <Setter Property="Background" Value="#A02A2216" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#E0B860" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedSyncAdvice.BothChanged}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sync tones (SyncTone on the DataContext): how a world's local copy relates to the shared one. -->
    <Style x:Key="DwToneBorder" TargetType="Border">
        <Setter Property="Background" Value="#99201915" />
        <Setter Property="BorderBrush" Value="{DynamicResource DwRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Good}">
                <Setter Property="BorderBrush" Value="{DynamicResource ToneSuccessBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ToneSuccessBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Info}">
                <Setter Property="BorderBrush" Value="{DynamicResource ToneInfoBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ToneInfoBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Warning}">
                <Setter Property="BorderBrush" Value="{DynamicResource ToneWarnBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ToneWarnBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Danger}">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Background" Value="#3A1C17" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DwToneText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Good}">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Info}">
                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Warning}">
                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:SyncTone.Danger}">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Shows its content only while there is some. -->
    <Style x:Key="DwOptionalContent" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small badge for a SyncBadge (Text, Tone). -->
    <Style x:Key="DwSyncBadge" TargetType="ContentControl" BasedOn="{StaticResource DwOptionalContent}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Style="{StaticResource DwToneBorder}" Padding="7,1">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource DwToneText}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
