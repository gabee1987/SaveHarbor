<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Arcane rune circle shown while an operation runs. It is a template, so it exists (and animates) only while busy. -->
    <DataTemplate x:Key="DwArcaneLoaderTemplate">
        <Viewbox Width="64" Height="64">
            <Grid Width="64" Height="64">
                <Ellipse x:Name="Glow" Width="44" Height="44" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#99B266FF" Offset="0" />
                            <GradientStop Color="#00B266FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid x:Name="OuterRing" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform />
                    </Grid.RenderTransform>
                    <Ellipse Width="60" Height="60" Stroke="#C9A24A" StrokeThickness="1.2" StrokeDashArray="1.5 2.5" />
                    <Path Data="M32,1 L34,4 L32,7 L30,4 Z" Fill="#EBD08A" />
                    <Path Data="M32,57 L34,60 L32,63 L30,60 Z" Fill="#EBD08A" />
                    <Path Data="M1,32 L4,30 L7,32 L4,34 Z" Fill="#EBD08A" />
                    <Path Data="M57,32 L60,30 L63,32 L60,34 Z" Fill="#EBD08A" />
                </Grid>

                <Ellipse Width="48" Height="48" Stroke="#7A5E2E" StrokeThickness="0.8" />

                <Path x:Name="Arcs" Data="M32,12 A20,20 0 0 1 52,32 M32,52 A20,20 0 0 1 12,32"
                      Stroke="#B266FF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                    <Path.Effect>
                        <DropShadowEffect Color="#B266FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                    </Path.Effect>
                </Path>

                <Path x:Name="Rune" Data="M32,20 L42.4,38 L21.6,38 Z M32,44 L21.6,26 L42.4,26 Z"
                      Stroke="#D4AF5F" StrokeThickness="0.9" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                </Path>

                <Ellipse x:Name="Orb" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFF6EEFF" Offset="0" />
                            <GradientStop Color="#C58FFF" Offset="0.45" />
                            <GradientStop Color="#00B266FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Canvas x:Name="Sparks" Width="64" Height="64" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform />
                    </Canvas.RenderTransform>
                    <Path Data="M32,3 L33,6 L36,7 L33,8 L32,11 L31,8 L28,7 L31,6 Z" Fill="#E9D6FF" />
                    <Path Data="M56,44 L57,46 L59,47 L57,48 L56,50 L55,48 L53,47 L55,46 Z" Fill="#C58FFF" />
                    <Path Data="M9,46 L10,48 L12,49 L10,50 L9,52 L8,50 L6,49 L8,48 Z" Fill="#EBD08A" />
                </Canvas>
            </Grid>
        </Viewbox>
        <DataTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="OuterRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:9" />
                        <DoubleAnimation Storyboard.TargetName="Arcs" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="360" To="0" Duration="0:0:1.6" />
                        <DoubleAnimation Storyboard.TargetName="Rune" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:6" />
                        <DoubleAnimation Storyboard.TargetName="Sparks" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:3" />
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="Orb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="0.8" To="1.2" Duration="0:0:0.9" />
                        <DoubleAnimation Storyboard.TargetName="Orb" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="0.8" To="1.2" Duration="0:0:0.9" />
                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                         From="0.3" To="0.75" Duration="0:0:0.9" />
                        <DoubleAnimation Storyboard.TargetName="Rune" Storyboard.TargetProperty="Opacity"
                                         From="0.45" To="1" Duration="0:0:0.9" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
