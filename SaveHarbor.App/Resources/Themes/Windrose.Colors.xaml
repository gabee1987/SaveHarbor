<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windrose: ink-washed charcoal, bone-white type, crimson sash and brass buckles. -->
    <RadialGradientBrush x:Key="AppBackgroundBrush" Center="0.5,0.15" GradientOrigin="0.5,0.15" RadiusX="1.0" RadiusY="0.95">
        <GradientStop Color="#1E1F21" Offset="0" />
        <GradientStop Color="#141516" Offset="0.6" />
        <GradientStop Color="#0B0C0D" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#18191B" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#131415" />
    <SolidColorBrush x:Key="InputBrush" Color="#0F1011" />
    <SolidColorBrush x:Key="LineBrush" Color="#3D3B37" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#2A2927" />
    <SolidColorBrush x:Key="InkBrush" Color="#EEE8DC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A9A296" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#7A746A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B8252C" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#CF333A" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#8E1A20" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F0585E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E5A64A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#88C27C" />
    <SolidColorBrush x:Key="InfoBrush" Color="#62B9B5" />

    <SolidColorBrush x:Key="OrnamentBrush" Color="#8C7550" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#F6F0E4" />
    <SolidColorBrush x:Key="PlayCardBackgroundBrush" Color="#231A1B" />

    <SolidColorBrush x:Key="ToneAccentBackgroundBrush" Color="#33171A" />
    <SolidColorBrush x:Key="ToneAccentBorderBrush" Color="#B8252C" />
    <SolidColorBrush x:Key="ToneInfoBackgroundBrush" Color="#16292A" />
    <SolidColorBrush x:Key="ToneInfoBorderBrush" Color="#3E8784" />
    <SolidColorBrush x:Key="ToneSuccessBackgroundBrush" Color="#1D2A1C" />
    <SolidColorBrush x:Key="ToneSuccessBorderBrush" Color="#5C8A52" />
    <SolidColorBrush x:Key="ToneWarnBackgroundBrush" Color="#33281A" />
    <SolidColorBrush x:Key="ToneWarnBorderBrush" Color="#A9793A" />
    <SolidColorBrush x:Key="ToneNeutralBackgroundBrush" Color="#1C1D1F" />

    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#25262A" />
    <SolidColorBrush x:Key="HoverLineBrush" Color="#5A5750" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#0F1011" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#141517" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#222326" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#3A1A1D" />

    <!-- Palatino and Book Antiqua ship with Windows; nothing is downloaded. -->
    <FontFamily x:Key="AppDisplayFontFamily">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
    <Visibility x:Key="ShowOrnamentGlyphs">Visible</Visibility>
    <PathGeometry x:Key="GameIconGeometry" Figures="M12,2 L14,10 L22,12 L14,14 L12,22 L10,14 L2,12 L10,10 Z" />
</ResourceDictionary>
