<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windrose list, tab and input styles. Brushes come from Windrose.Styles.xaml (DynamicResource across dictionaries). -->

    <!-- World rows: dark planks with a compass badge; the selected row wears the crimson sash with a bone edge. -->
    <Style x:Key="SkinWorldItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,0,0,6">
                        <Border x:Name="Row" Background="{DynamicResource SkinRowBrush}" BorderBrush="{DynamicResource SkinRowBorderBrush}"
                                BorderThickness="1" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="22" Height="22" Margin="0,0,11,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="Badge" Stroke="{DynamicResource SkinFrameBrush}" StrokeThickness="1.2" />
                                    <Path x:Name="BadgeMark" Data="M11,3 L12.6,9.4 L19,11 L12.6,12.6 L11,19 L9.4,12.6 L3,11 L9.4,9.4 Z"
                                          Fill="{DynamicResource SkinFrameBrush}" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Rectangle x:Name="Sash" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource SkinCrimsonBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SkinFrameBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SkinSelectedRowBrush}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="#8E8679" />
                            <Setter TargetName="Badge" Property="Stroke" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="BadgeMark" Property="Fill" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="Sash" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Row" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#C2292F" BlurRadius="14" ShadowDepth="0" Opacity="0.3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="AlternationCount" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource SkinFrameInnerBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <!-- The standard part name lets screen readers and UI automation reach the tab content. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Palatino capitals like the game's CHARACTER / FLAGSHIP / MAP menu; the active tab is underlined in crimson. -->
    <Style x:Key="SkinTabItem" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Path x:Name="Separator" Data="{DynamicResource SkinDiamondGeometry}" Fill="{DynamicResource SkinFrameBrush}"
                              Width="5" Height="5" Stretch="Uniform" Margin="14,0,14,4" VerticalAlignment="Center" />
                        <Grid>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Header}" FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10" />
                            <Path x:Name="Stroke" Data="{DynamicResource SkinBrushStrokeGeometry}" Fill="{DynamicResource SkinBrushStrokeBrush}"
                                  Height="5" Stretch="Fill" VerticalAlignment="Bottom" Margin="-4,0,-10,0" Visibility="Hidden" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="Stroke" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinGameSwitch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Margin="12,0">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   FontSize="13.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" />
                        <Path x:Name="Stroke" Data="{DynamicResource SkinBrushStrokeGeometry}" Fill="{DynamicResource SkinBrushStrokeBrush}"
                              Height="5" Stretch="Fill" VerticalAlignment="Bottom" Margin="-4,0,-10,0" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="Stroke" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square toggle with an iron frame; crimson when on. -->
    <Style x:Key="SkinToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="30" Height="30" Background="#99111213" BorderBrush="{DynamicResource SkinRowBorderBrush}" BorderThickness="1">
                        <Border x:Name="Fill" Margin="7" Background="{DynamicResource SkinFrameInnerBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SkinFrameBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#8E8679" />
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SkinGoldFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SkinGoldBrightBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SkinCrimsonBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" Background="#99111213" BorderBrush="{DynamicResource SkinRowBorderBrush}" BorderThickness="1" Padding="10,6">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#8E8679" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel heading: Palatino capitals over an iron hairline with a crimson brush stroke at its start. -->
    <Style x:Key="SkinPanelHeading" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="15"
                                   Foreground="{DynamicResource SkinParchmentBrush}" />
                        <Grid Margin="0,6,0,0" Height="7">
                            <Rectangle Height="1" Fill="{DynamicResource SkinFadeRightBrush}" VerticalAlignment="Center" />
                            <Path Data="{DynamicResource SkinBrushStrokeGeometry}" Fill="{DynamicResource SkinBrushStrokeBrush}"
                                  Width="150" Height="6" Stretch="Fill" HorizontalAlignment="Left" Margin="-3,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A settings row: dark band with label on the left, control on the right. -->
    <Style x:Key="SkinSettingRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SkinRowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkinRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
</ResourceDictionary>
