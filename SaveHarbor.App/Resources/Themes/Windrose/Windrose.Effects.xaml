<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Drifting ash instead of embers. -->
    <SolidColorBrush x:Key="SkinEmberBrush" Color="#D9D2C5" />

    <!-- Ink-washed backdrop with two crimson brush strokes, echoing the game's key art. Static: no animation. -->
    <DataTemplate x:Key="SkinSmokeTemplate">
        <Grid IsHitTestVisible="False">
            <Ellipse Width="980" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-160,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3A47494C" Offset="0" />
                        <GradientStop Color="#0047494C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="1100" Height="640" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-300,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2C3C3E41" Offset="0" />
                        <GradientStop Color="#003C3E41" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Data="M0,40 C120,12 380,0 700,16 C860,24 940,38 1000,46 C900,58 720,68 480,70 C300,72 120,78 0,60 Z"
                  Width="760" Height="70" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-120,0,0,40"
                  RenderTransformOrigin="0,0.5" Opacity="0.32">
                <Path.RenderTransform>
                    <RotateTransform Angle="-9" />
                </Path.RenderTransform>
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#C01E25" Offset="0" />
                        <GradientStop Color="#8E141A" Offset="0.7" />
                        <GradientStop Color="#008E141A" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path Data="M0,40 C120,12 380,0 700,16 C860,24 940,38 1000,46 C900,58 720,68 480,70 C300,72 120,78 0,60 Z"
                  Width="620" Height="46" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,-90,0"
                  RenderTransformOrigin="1,0.5" Opacity="0.22">
                <Path.RenderTransform>
                    <RotateTransform Angle="-7" />
                </Path.RenderTransform>
                <Path.Fill>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Color="#C01E25" Offset="0" />
                        <GradientStop Color="#8E141A" Offset="0.6" />
                        <GradientStop Color="#008E141A" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush RadiusX="0.75" RadiusY="0.8">
                        <GradientStop Color="#00000000" Offset="0.55" />
                        <GradientStop Color="#A0000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </DataTemplate>

    <!-- A brass ship's wheel turning under a dashed compass ring while an operation runs. A template, so it exists (and
         animates) only while busy. -->
    <DataTemplate x:Key="SkinArcaneLoaderTemplate">
        <Viewbox Width="64" Height="64">
            <Grid Width="64" Height="64">
                <Ellipse x:Name="Glow" Width="46" Height="46" Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#88C2292F" Offset="0" />
                            <GradientStop Color="#00C2292F" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid x:Name="Ring" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform />
                    </Grid.RenderTransform>
                    <Ellipse Width="63" Height="63" Stroke="#6F6A61" StrokeThickness="0.8" StrokeDashArray="2 3" />
                </Grid>

                <Path x:Name="Wheel" Stroke="#C9AA6E" StrokeThickness="2" Fill="#00000000" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                    <Path.Data>
                        <GeometryGroup>
                            <EllipseGeometry Center="32,32" RadiusX="20" RadiusY="20" />
                            <EllipseGeometry Center="32,32" RadiusX="16.5" RadiusY="16.5" />
                            <EllipseGeometry Center="32,32" RadiusX="5" RadiusY="5" />
                            <LineGeometry StartPoint="37.00,32.00" EndPoint="58.00,32.00" />
                            <LineGeometry StartPoint="35.54,35.54" EndPoint="50.38,50.38" />
                            <LineGeometry StartPoint="32.00,37.00" EndPoint="32.00,58.00" />
                            <LineGeometry StartPoint="28.46,35.54" EndPoint="13.62,50.38" />
                            <LineGeometry StartPoint="27.00,32.00" EndPoint="6.00,32.00" />
                            <LineGeometry StartPoint="28.46,28.46" EndPoint="13.62,13.62" />
                            <LineGeometry StartPoint="32.00,27.00" EndPoint="32.00,6.00" />
                            <LineGeometry StartPoint="35.54,28.46" EndPoint="50.38,13.62" />
                            <EllipseGeometry Center="60.50,32.00" RadiusX="2.4" RadiusY="2.4" />
                            <EllipseGeometry Center="52.15,52.15" RadiusX="2.4" RadiusY="2.4" />
                            <EllipseGeometry Center="32.00,60.50" RadiusX="2.4" RadiusY="2.4" />
                            <EllipseGeometry Center="11.85,52.15" RadiusX="2.4" RadiusY="2.4" />
                            <EllipseGeometry Center="3.50,32.00" RadiusX="2.4" RadiusY="2.4" />
                            <EllipseGeometry Center="11.85,11.85" RadiusX="2.4" RadiusY="2.4" />
                            <EllipseGeometry Center="32.00,3.50" RadiusX="2.4" RadiusY="2.4" />
                            <EllipseGeometry Center="52.15,11.85" RadiusX="2.4" RadiusY="2.4" />
                        </GeometryGroup>
                    </Path.Data>
                    <Path.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.7" />
                    </Path.Effect>
                </Path>

                <Ellipse Width="7" Height="7" Fill="#C2292F" />
            </Grid>
        </Viewbox>
        <DataTemplate.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <!-- Each part repeats on its own and turns at a steady speed, so the spinner never looks stalled. -->
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Wheel" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:2.4" RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="360" To="0" Duration="0:0:12" RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.25" To="0.7" Duration="0:0:1.1" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
