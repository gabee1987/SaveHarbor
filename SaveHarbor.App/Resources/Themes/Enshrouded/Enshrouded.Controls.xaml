<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Enshrouded list, tab and input styles. Brushes come from Enshrouded.Styles.xaml (DynamicResource across dictionaries). -->

    <!-- World rows: framed like the game's world list, with a gem badge; the selected row gets a bright gold frame,
         a lit gem and a warm glow. -->
    <Style x:Key="SkinWorldItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="{DynamicResource SkinRowBrush}" BorderBrush="{DynamicResource SkinRowBorderBrush}"
                            BorderThickness="1" Margin="0,0,0,6" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" Margin="0,0,11,0" VerticalAlignment="Center">
                                <Path x:Name="Badge" Data="M11,1 L21,11 L11,21 L1,11 Z" Fill="{DynamicResource SkinGemPlateBrush}"
                                      Stroke="{DynamicResource SkinFrameBrush}" StrokeThickness="1.2" />
                                <Path x:Name="BadgeMark" Data="{DynamicResource SkinFlameGeometry}" Fill="{DynamicResource SkinFrameBrush}"
                                      Width="7" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SkinFrameBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SkinSelectedRowBrush}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="Badge" Property="Stroke" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="BadgeMark" Property="Fill" Value="{DynamicResource SkinFlameBrush}" />
                            <Setter TargetName="BadgeMark" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F0A848" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Row" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#D8B868" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="AlternationCount" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource SkinFrameInnerBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <!-- The standard part name lets screen readers and UI automation reach the tab content. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tracked capitals separated by small rings; the active tab glows like the game's settings tabs. -->
    <!-- The hand is on the header only; set on the TabItem it would also cover the tab's page. -->
    <Style x:Key="SkinTabItem" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                        <Ellipse x:Name="Separator" Width="5" Height="5" Stroke="{DynamicResource SkinFrameBrush}" StrokeThickness="1"
                                 Margin="14,0,14,4" VerticalAlignment="Center" />
                        <Grid>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Header}" FontFamily="{DynamicResource AppDisplayFontFamily}"
                                       FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10" />
                            <Rectangle x:Name="Glow" Height="2" VerticalAlignment="Bottom" Margin="-6,0,-6,-1" Fill="{DynamicResource SkinGlowLineBrush}"
                                       Visibility="Hidden">
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="#E6CB86" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                </Rectangle.Effect>
                            </Rectangle>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SkinParchmentBrush}" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A gem before each game name; the active game's gem is lit gold and glows, with a gold line under the name. -->
    <Style x:Key="SkinGameSwitch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Gem" Data="M4.5,0 L9,4.5 L4.5,9 L0,4.5 Z" Fill="{DynamicResource InputBrush}" Stroke="{DynamicResource SkinFrameBrush}"
                              StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,7,2" />
                        <TextBlock x:Name="Label" Grid.Column="1" Text="{TemplateBinding Content}" FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,7" />
                        <Rectangle x:Name="Glow" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" Margin="-4,0" Fill="{DynamicResource SkinGlowLineBrush}"
                                   Visibility="Hidden">
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#E6CB86" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBrush}" />
                            <Setter TargetName="Gem" Property="Stroke" Value="{DynamicResource SkinGoldBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SkinParchmentBrush}" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Gem" Property="Fill" Value="{DynamicResource SkinGoldFillBrush}" />
                            <Setter TargetName="Gem" Property="Stroke" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="Gem" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E6CB86" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square toggle like the game's settings checkboxes: framed box, gold fill when on. -->
    <Style x:Key="SkinToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="30" Height="30" Background="#99151A1F" BorderBrush="{DynamicResource SkinRowBorderBrush}" BorderThickness="1">
                        <Border x:Name="Fill" Margin="7" Background="{DynamicResource SkinFrameInnerBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SkinFrameBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SkinGoldBrush}" />
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SkinGoldFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SkinGoldBrightBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SkinGoldBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" Background="#99151A1F" BorderBrush="{DynamicResource SkinRowBorderBrush}" BorderThickness="1" Padding="10,6">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SkinGoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel heading: tracked capitals over a gold rule that ends in the "o<>o" ornament. -->
    <Style x:Key="SkinPanelHeading" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="14"
                                   Foreground="{DynamicResource SkinParchmentBrush}" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Height="1" Fill="{DynamicResource SkinFrameBrush}" VerticalAlignment="Center" />
                            <Path Grid.Column="1" Data="{DynamicResource SkinRuleEndGeometry}" Stroke="{DynamicResource SkinGoldBrush}"
                                  Fill="{DynamicResource SkinGoldBrush}" StrokeThickness="1" Width="42" Height="8" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A settings row: dark band with label on the left, control on the right. -->
    <Style x:Key="SkinSettingRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SkinRowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkinRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
</ResourceDictionary>
