<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <RadialGradientBrush x:Key="AppBackgroundBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.1" RadiusY="1.0">
        <GradientStop Color="#2B1C47" Offset="0" />
        <GradientStop Color="#1A1229" Offset="0.55" />
        <GradientStop Color="#0E0A17" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#221A3A" Offset="0" />
        <GradientStop Color="#1A1429" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#171226" />
    <SolidColorBrush x:Key="InputBrush" Color="#110D1E" />
    <SolidColorBrush x:Key="LineBrush" Color="#41325F" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#2B2144" />
    <SolidColorBrush x:Key="InkBrush" Color="#F3EAD8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#B9A9D0" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#8576A6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#9D6CFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#B58CFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#7C4DDB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F0707A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F0A850" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#7FD19A" />
    <SolidColorBrush x:Key="InfoBrush" Color="#86B4F0" />

    <SolidColorBrush x:Key="OrnamentBrush" Color="#C9A24A" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#170A2B" />
    <LinearGradientBrush x:Key="PlayCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33225C" Offset="0" />
        <GradientStop Color="#1B1230" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayCardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9D6CFF" Offset="0" />
        <GradientStop Color="#C9A24A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderDividerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#002B2144" Offset="0" />
        <GradientStop Color="#7C4DDB" Offset="0.3" />
        <GradientStop Color="#C9A24A" Offset="0.5" />
        <GradientStop Color="#7C4DDB" Offset="0.7" />
        <GradientStop Color="#002B2144" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ToneAccentBackgroundBrush" Color="#2E2050" />
    <SolidColorBrush x:Key="ToneAccentBorderBrush" Color="#9D6CFF" />
    <SolidColorBrush x:Key="ToneInfoBackgroundBrush" Color="#1B2740" />
    <SolidColorBrush x:Key="ToneInfoBorderBrush" Color="#4F78A8" />
    <SolidColorBrush x:Key="ToneSuccessBackgroundBrush" Color="#1D3027" />
    <SolidColorBrush x:Key="ToneSuccessBorderBrush" Color="#4F9A6C" />
    <SolidColorBrush x:Key="ToneWarnBackgroundBrush" Color="#3A2A1A" />
    <SolidColorBrush x:Key="ToneWarnBorderBrush" Color="#C08336" />
    <SolidColorBrush x:Key="ToneNeutralBackgroundBrush" Color="#1D1730" />

    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#2A2045" />
    <SolidColorBrush x:Key="HoverLineBrush" Color="#5A4690" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#120C20" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#161027" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#2A2045" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#3B2A66" />

    <Color x:Key="PlayGlowColor">#9D6CFF</Color>
    <sys:Double x:Key="PlayGlowOpacity">0.4</sys:Double>

    <FontFamily x:Key="AppDisplayFontFamily">/SaveHarbor.App;component/Resources/Fonts/#Cinzel, Georgia</FontFamily>
    <Visibility x:Key="ShowOrnamentGlyphs">Visible</Visibility>
    <PathGeometry x:Key="GameIconGeometry" Figures="M12,2 C16,6 20,7 22,7 C21,14 17,19 12,22 C7,19 3,14 2,7 C4,7 8,6 12,2 Z" />
</ResourceDictionary>
