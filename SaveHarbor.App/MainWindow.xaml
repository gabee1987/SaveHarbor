<Window x:Class="SaveHarbor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SaveHarbor.App.Views.Controls"
        xmlns:domain="clr-namespace:SaveHarbor.App.Domain"
        xmlns:dragonwilds="clr-namespace:SaveHarbor.App.Views.Dragonwilds"
        xmlns:windrose="clr-namespace:SaveHarbor.App.Views.Windrose"
        xmlns:ui="clr-namespace:SaveHarbor.App.Localization"
        mc:Ignorable="d"
        Title="{ui:UiText App.Title}"
        Height="920"
        Width="1440"
        MinHeight="720"
        MinWidth="1100"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Each game has its own shell. Only the active game's template is instantiated, so the other game's
             views and resources are created when the user switches to it. -->
        <DataTemplate x:Key="WindroseShellTemplate">
            <windrose:WindroseShellView />
        </DataTemplate>
        <DataTemplate x:Key="DragonwildsShellTemplate">
            <dragonwilds:DragonwildsShellView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ContentControl Content="{Binding}" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource WindroseShellTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveGameId}" Value="{x:Static domain:GameId.Dragonwilds}">
                            <Setter Property="ContentTemplate" Value="{StaticResource DragonwildsShellTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <controls:ToastHostView HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,20,64" />
    </Grid>
</Window>
