<Window x:Class="SaveHarbor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SaveHarbor.App.Views.Controls"
        xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
        xmlns:dragonwilds="clr-namespace:SaveHarbor.App.Views.Dragonwilds"
        xmlns:enshrouded="clr-namespace:SaveHarbor.App.Views.Enshrouded"
        xmlns:windrose="clr-namespace:SaveHarbor.App.Views.Windrose"
        xmlns:ui="clr-namespace:SaveHarbor.App.Localization"
        mc:Ignorable="d"
        Title="{ui:UiText App.Title}"
        Height="920"
        Width="1440"
        MinHeight="720"
        MinWidth="1100"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Each game has its own shell, keyed "<GameId>ShellTemplate". Only the active game's template is
             instantiated, so another game's views and resources are created when the user switches to it. -->
        <converters:GameShellTemplateConverter x:Key="GameShellTemplateConverter">
            <converters:GameShellTemplateConverter.Templates>
                <ResourceDictionary>
                    <DataTemplate x:Key="WindroseShellTemplate">
                        <windrose:WindroseShellView />
                    </DataTemplate>
                    <DataTemplate x:Key="DragonwildsShellTemplate">
                        <dragonwilds:DragonwildsShellView />
                    </DataTemplate>
                    <DataTemplate x:Key="EnshroudedShellTemplate">
                        <enshrouded:EnshroudedShellView />
                    </DataTemplate>
                </ResourceDictionary>
            </converters:GameShellTemplateConverter.Templates>
        </converters:GameShellTemplateConverter>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ContentControl Content="{Binding}"
                        ContentTemplate="{Binding ActiveGameId, Converter={StaticResource GameShellTemplateConverter}}"
                        Focusable="False" />

        <controls:ToastHostView HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,20,64" />
    </Grid>
</Window>
