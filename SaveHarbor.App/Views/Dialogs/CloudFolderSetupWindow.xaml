<Window x:Class="SaveHarbor.App.Views.Dialogs.CloudFolderSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SaveHarbor.App.Views.Controls"
        xmlns:ui="clr-namespace:SaveHarbor.App.Localization"
        Title="{ui:UiText CloudSetup.Title}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid>
        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="{ui:UiText CloudSetup.Title}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{ui:UiText CloudSetup.Subtitle}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>
                        <StackPanel x:Name="SavedFoldersPanel" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="{ui:UiText CloudSetup.SavedFolders}"
                                       Style="{StaticResource MicroLabel}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SavedFolderPicker"
                                          MinHeight="40"
                                          SelectionChanged="SavedFolderPicker_SelectionChanged"
                                          ToolTip="{ui:UiText CloudSetup.SavedFoldersTooltip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FolderId}" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="ForgetButton"
                                        Grid.Column="2"
                                        Content="{ui:UiText CloudSetup.Forget}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="80"
                                        MinHeight="34"
                                        IsEnabled="False"
                                        ToolTip="{ui:UiText CloudSetup.ForgetTooltip}"
                                        Click="ForgetButton_Click" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{ui:UiText CloudSetup.FolderLink}"
                                   Style="{StaticResource MicroLabel}" />
                        <TextBox x:Name="FolderInput"
                                 Margin="0,7,0,0"
                                 MinHeight="36"
                                 Padding="9,7"
                                 Background="{DynamicResource InputBrush}"
                                 BorderBrush="{DynamicResource LineBrush}"
                                 Foreground="{DynamicResource InkBrush}"
                                 CaretBrush="{DynamicResource InkBrush}"
                                 TextWrapping="NoWrap"
                                 ToolTip="{ui:UiText CloudSetup.FolderLinkTooltip}" />
                        <TextBlock Text="{ui:UiText CloudSetup.Help}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Row="4"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="{ui:UiText CloudSetup.Ready}"
                           TextWrapping="Wrap"
                           LineHeight="18" />

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="{ui:UiText CloudSetup.Cancel}"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="96"
                            MinHeight="34"
                            Click="CancelButton_Click" />

                    <Button x:Name="TestButton"
                            Grid.Column="3"
                            Content="{ui:UiText CloudSetup.Test}"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="104"
                            MinHeight="34"
                            Click="TestButton_Click" />

                    <Button x:Name="SaveButton"
                            Grid.Column="5"
                            Content="{ui:UiText CloudSetup.Save}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="104"
                            MinHeight="34"
                            IsEnabled="False"
                            Click="SaveButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <controls:IndeterminateProgressLineView x:Name="SetupProgressLine"
                                                VerticalAlignment="Bottom" />
    </Grid>
</Window>
