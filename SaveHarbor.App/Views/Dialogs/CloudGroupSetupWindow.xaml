<Window x:Class="SaveHarbor.App.Views.Dialogs.CloudGroupSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SaveHarbor.App.Views.Behaviors"
        xmlns:controls="clr-namespace:SaveHarbor.App.Views.Controls"
        xmlns:vm="clr-namespace:SaveHarbor.App.ViewModels"
        xmlns:ui="clr-namespace:SaveHarbor.App.Localization"
        Title="{ui:UiText CloudGroup.Title}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="StepPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="{ui:UiText CloudGroup.Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="{ui:UiText CloudGroup.Subtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowSignedInHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center">
                        <Run Text="{ui:UiText CloudGroup.SignedInAs}" />
                        <Run Text="{Binding SignedInEmail, Mode=OneWay}" Foreground="{DynamicResource InkBrush}" />
                        <Run Text=" · " />
                    </TextBlock>
                    <Button Content="{ui:UiText CloudGroup.SignOut}" Command="{Binding SignOutCommand}" Style="{DynamicResource SkinLinkButton}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Step 1: e-mail -->
                <Border Style="{StaticResource StepPanel}" Margin="0,14,0,0" Visibility="{Binding IsEmailStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{ui:UiText CloudGroup.EmailLabel}" Style="{StaticResource MicroLabel}" />
                        <TextBox x:Name="EmailInput" Style="{StaticResource FieldBox}" MaxLength="254"
                                 AutomationProperties.Name="{ui:UiText CloudGroup.EmailLabel}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{ui:UiText CloudGroup.EmailHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Button Content="{ui:UiText CloudGroup.EmailSend}" Command="{Binding SendCodeCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" MinWidth="120" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Step 2: code -->
                <Border Style="{StaticResource StepPanel}" Margin="0,14,0,0" Visibility="{Binding IsCodeStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{ui:UiText CloudGroup.CodeLabel}" Style="{StaticResource MicroLabel}" />
                        <TextBox x:Name="CodeInput" Style="{StaticResource FieldBox}" MaxLength="6" Width="160" HorizontalAlignment="Left"
                                 FontSize="20" FontFamily="Consolas" InputMethod.IsInputMethodEnabled="False"
                                 AutomationProperties.Name="{ui:UiText CloudGroup.CodeLabel}"
                                 Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="CodeInput_PreviewTextInput"
                                 TextChanged="CodeInput_TextChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding VerifyCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{ui:UiText CloudGroup.CodeHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding ResendText}" Command="{Binding ResendCommand}" Style="{DynamicResource SkinLinkButton}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{ui:UiText CloudGroup.CodeDifferentEmail}" Command="{Binding UseDifferentEmailCommand}"
                                    Style="{DynamicResource SkinLinkButton}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <Button Grid.Column="3" Content="{ui:UiText CloudGroup.CodeSignIn}" Command="{Binding VerifyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="120" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 3: group -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsGroupStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource StepPanel}" Margin="0,0,0,10" Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{ui:UiText CloudGroup.GroupYours}" Style="{StaticResource MicroLabel}" />
                            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CloudGroupOption}">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11.5" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{ui:UiText CloudGroup.GroupUse}" Style="{StaticResource SecondaryButton}" MinWidth="120"
                                                    Command="{Binding DataContext.UseGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" AutomationProperties.HelpText="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StepPanel}">
                        <StackPanel>
                            <TextBlock Text="{ui:UiText CloudGroup.DisplayNameLabel}" Style="{StaticResource MicroLabel}" />
                            <TextBox Style="{StaticResource FieldBox}" MaxLength="32" AutomationProperties.Name="{ui:UiText CloudGroup.DisplayNameLabel}"
                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="{ui:UiText CloudGroup.GroupBothGames}" IsChecked="{Binding ApplyToAllGames}"
                                      Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0" />

                            <TextBlock Text="{ui:UiText CloudGroup.InviteTitle}" Style="{StaticResource MicroLabel}" Margin="0,16,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InviteInput" Style="{StaticResource FieldBox}" MaxLength="16" CharacterCasing="Upper" FontFamily="Consolas"
                                         AutomationProperties.Name="{ui:UiText CloudGroup.InviteLabel}"
                                         Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding JoinCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="{ui:UiText CloudGroup.InviteJoin}" Command="{Binding JoinCommand}" Style="{StaticResource PrimaryButton}"
                                        MinWidth="100" Margin="8,6,0,0" />
                            </Grid>

                            <TextBlock Text="{ui:UiText CloudGroup.CreateTitle}" Style="{StaticResource MicroLabel}" Margin="0,16,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource FieldBox}" MaxLength="60" AutomationProperties.Name="{ui:UiText CloudGroup.CreateNameLabel}"
                                         Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding CreateCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="{ui:UiText CloudGroup.CreateButton}" Command="{Binding CreateCommand}" Style="{StaticResource SecondaryButton}"
                                        MinWidth="100" Margin="8,6,0,0" />
                            </Grid>
                            <TextBlock Text="{ui:UiText CloudGroup.CreateHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- After creating a group: its invite code -->
                <Border Style="{StaticResource StepPanel}" Margin="0,14,0,0" Visibility="{Binding IsCreatedStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{ui:UiText CloudGroup.CreatedTitle}" Style="{StaticResource MicroLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding CreatedInviteCode}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                                       VerticalAlignment="Center" AutomationProperties.Name="{ui:UiText CloudGroup.InviteLabel}" />
                            <Button Content="{ui:UiText CloudGroup.CreatedCopy}" Style="{StaticResource SecondaryButton}" Margin="14,0,0,0" MinWidth="80" VerticalAlignment="Center"
                                    Command="{x:Static behaviors:ClipboardCommands.Copy}" CommandParameter="{Binding CreatedInviteCode}" />
                        </StackPanel>
                        <TextBlock Text="{ui:UiText CloudGroup.CreatedHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Button Content="{ui:UiText CloudGroup.CreatedDone}" Command="{Binding FinishCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" MinWidth="120" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="18" Margin="0,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Message}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="{ui:UiText CloudGroup.Close}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" MinWidth="96" Margin="0,14,0,0" IsCancel="True" />
            </StackPanel>
        </Border>

        <controls:IndeterminateProgressLineView IsActive="{Binding IsBusy}" VerticalAlignment="Bottom" />
    </Grid>
</Window>
