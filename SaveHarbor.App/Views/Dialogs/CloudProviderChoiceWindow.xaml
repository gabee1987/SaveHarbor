<Window x:Class="SaveHarbor.App.Views.Dialogs.CloudProviderChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:SaveHarbor.App.Views.Dialogs"
        xmlns:ui="clr-namespace:SaveHarbor.App.Localization"
        Title="{ui:UiText CloudProviderChoice.Title}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18">
        <StackPanel>
            <TextBlock Text="{ui:UiText CloudProviderChoice.Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{ui:UiText CloudProviderChoice.Subtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,14" />

            <ItemsControl x:Name="ChoiceList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dialogs:CloudProviderChoiceCard}">
                        <Border Background="{DynamicResource PanelAltBrush}"
                                BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                        <Border Background="{DynamicResource ToneAccentBackgroundBrush}"
                                                BorderBrush="{DynamicResource ToneAccentBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsRecommended, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{ui:UiText CloudProviderChoice.Recommended}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{ui:UiText CloudProviderChoice.Use}"
                                        Tag="{Binding Kind}"
                                        MinWidth="96"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding UseAutomationName}"
                                        Click="ChooseButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="{ui:UiText CloudProviderChoice.Later}"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Margin="0,4,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Border>
</Window>
