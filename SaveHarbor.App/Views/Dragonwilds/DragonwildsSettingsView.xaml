<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <Grid>
        <Border Background="{DynamicResource DwOverlayBrush}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}" />
            </Border.InputBindings>
        </Border>

        <ContentControl Style="{DynamicResource DwFrame}"
                        BorderBrush="{DynamicResource DwGoldBrush}"
                        Width="780"
                        MaxHeight="680"
                        Margin="24"
                        Padding="30,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl Style="{DynamicResource DwPageHeading}" Content="{ui:SpacedText Dragonwilds.Settings}" FontSize="26" Margin="0,0,0,18" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <ContentControl Style="{DynamicResource DwPanelHeading}" Content="{ui:SpacedText Settings.Player}" />
                        <Border Style="{DynamicResource DwSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.PlayerName}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0">
                                        <Run Text="{ui:UiText Settings.PlayerNameHint}" />
                                        <Run Text="{Binding Settings.EffectivePlayerName, Mode=OneWay}" Foreground="{DynamicResource DwGoldBrightBrush}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{DynamicResource DwTextBox}" MaxLength="32" VerticalAlignment="Center"
                                         Text="{Binding Settings.PlayerName, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                        </Border>

                        <ContentControl Style="{DynamicResource DwPanelHeading}" Content="{ui:SpacedText Settings.Saves}" Margin="0,12,0,14" />
                        <Border Style="{DynamicResource DwSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Foreground="{DynamicResource InkBrush}" FontSize="13.5">
                                        <Run Text="{Binding Settings.GameName, Mode=OneWay}" />
                                        <Run Text="{ui:UiText Settings.SaveFolderSuffix}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Settings.SaveFolder}" Style="{DynamicResource DwMuted}" Margin="0,3,0,0" ToolTip="{Binding Settings.SaveFolder}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{ui:SpacedText Settings.Reset}" Command="{Binding Settings.ResetSaveFolderCommand}" Style="{DynamicResource DwButton}"
                                            Margin="0,0,8,0" ToolTip="{ui:UiText Settings.ResetTooltip}"
                                            Visibility="{Binding Settings.HasCustomSaveFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Content="{ui:SpacedText Settings.Open}" Command="{Binding Settings.OpenSaveFolderCommand}" Style="{DynamicResource DwButton}"
                                            Margin="0,0,8,0" ToolTip="{ui:UiText Settings.OpenSaveFolderTooltip}" />
                                    <Button Content="{ui:SpacedText Settings.Browse}" Command="{Binding Settings.BrowseSaveFolderCommand}" Style="{DynamicResource DwButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource DwSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.BackupFolder}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{Binding Settings.BackupFolder}" Style="{DynamicResource DwMuted}" Margin="0,3,0,0" ToolTip="{Binding Settings.BackupFolder}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{ui:SpacedText Settings.Open}" Command="{Binding Settings.OpenBackupFolderCommand}"
                                        Style="{DynamicResource DwButton}" VerticalAlignment="Center" ToolTip="{ui:UiText Settings.BackupFolderTooltip}" />
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource DwSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.KeepBackups}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.KeepBackupsHint}" Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                          ItemsSource="{Binding Settings.RetentionOptions}"
                                          SelectedItem="{Binding Settings.SelectedRetention}" />
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource DwSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.SharedFolder}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.SharedFolderHint}" Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{ui:SpacedText Settings.Change}" Command="{Binding SetupCloudFolderCommand}"
                                        Style="{DynamicResource DwButton}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource DwSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.KeepSharedVersions}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.KeepSharedVersionsHint}" Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                          ItemsSource="{Binding Settings.CloudRetentionOptions}"
                                          SelectedItem="{Binding Settings.SelectedCloudRetention}" />
                            </Grid>
                        </Border>

                        <ContentControl Style="{DynamicResource DwPanelHeading}" Content="{ui:SpacedText Settings.Appearance}" Margin="0,12,0,14" />
                        <Border Style="{DynamicResource DwSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.AmbientEffects}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.AmbientEffectsHint}" Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{DynamicResource DwToggle}" VerticalAlignment="Center" IsChecked="{Binding Settings.AmbientEffects}" />
                            </Grid>
                        </Border>

                        <ContentControl Style="{DynamicResource DwPanelHeading}" Content="{ui:SpacedText Settings.Support}" Margin="0,12,0,14" />
                        <Border Style="{DynamicResource DwSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.Troubleshooting}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.TroubleshootingHint}" Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{ui:SpacedText Settings.OpenLogs}" Command="{Binding Settings.OpenLogsFolderCommand}" Style="{DynamicResource DwButton}" Margin="0,0,8,0" />
                                    <Button Content="{ui:SpacedText Settings.OpenData}" Command="{Binding Settings.OpenDataFolderCommand}" Style="{DynamicResource DwButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="{ui:SpacedText Settings.Back}" Command="{Binding CloseSettingsCommand}" Style="{DynamicResource DwButton}" />
                    <Border BorderBrush="{DynamicResource DwParchmentBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ESC" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DwParchmentBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
