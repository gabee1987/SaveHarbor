<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsHeroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <ContentControl Style="{DynamicResource DwFrame}" BorderBrush="{DynamicResource DwGoldBrush}" Padding="24,18">
        <Grid MinHeight="124">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- No world selected: one short instruction instead of empty fields. -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding SelectedWorld, Converter={x:Static converters:NullToVisibleConverter.Instance}}">
                <TextBlock Text="{ui:UiText Dragonwilds.ChooseWorld}"
                           FontFamily="{DynamicResource AppDisplayFontFamily}"
                           FontSize="24"
                           Foreground="{DynamicResource DwGoldTextBrush}" />
                <TextBlock Text="{ui:UiText Dragonwilds.ChooseWorldHint}" Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding SelectedWorld, Converter={x:Static converters:NullToCollapsedConverter.Instance}}">
                <TextBlock Text="{ui:SpacedText Dragonwilds.SelectedWorld}" Style="{DynamicResource DwLabel}" FontFamily="{DynamicResource AppDisplayFontFamily}" />
                <TextBlock Text="{Binding SelectedWorld.WorldName}"
                           FontFamily="{DynamicResource AppDisplayFontFamily}"
                           FontSize="32"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource DwGoldTextBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.6" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Style="{DynamicResource DwMuted}" Margin="1,2,0,0">
                    <Run Text="{ui:UiText Dragonwilds.LastPlayed}" />
                    <Run Text="{Binding SelectedWorld.LastModifiedAt, Mode=OneWay, Converter={x:Static converters:RelativeAgeConverter.Instance}}" />
                    <Run Text=" · " />
                    <Run Text="{Binding SelectedWorldSize, Mode=OneWay}" />
                </TextBlock>

                <WrapPanel Margin="0,12,0,0">
                    <Border Style="{DynamicResource DwPill}"
                            Visibility="{Binding CloudStatus.LatestVersion, Converter={x:Static converters:NullToCollapsedConverter.Instance}}"
                            ToolTip="{ui:UiText Header.LatestTooltip}">
                        <TextBlock Foreground="{DynamicResource InkBrush}" FontSize="12">
                            <Run Text="{ui:UiText Dragonwilds.Shared}" Foreground="{DynamicResource MutedBrush}" />
                            <Run Text="{Binding CloudLatestVersionText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Style="{DynamicResource DwPill}"
                            BorderBrush="{DynamicResource ToneWarnBorderBrush}"
                            Visibility="{Binding IsOtherPlayerHosting, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding CloudSessionTooltip}">
                        <TextBlock Foreground="{DynamicResource WarnBrush}" FontSize="12" FontWeight="SemiBold">
                            <Run Text="{ui:UiText Dragonwilds.HostedBy}" />
                            <Run Text="{Binding CloudSessionText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Style="{DynamicResource DwPill}"
                            BorderBrush="{DynamicResource DwMagicBrush}"
                            Visibility="{Binding IsOwnSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding CloudSessionTooltip}">
                        <TextBlock Text="{ui:UiText Dragonwilds.YouAreHosting}" Foreground="{DynamicResource InfoBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="{ui:SpacedText Dragonwilds.AllWorldInfo}"
                            Command="{Binding OpenWorldInspectorCommand}"
                            Style="{DynamicResource DwButton}"
                            Padding="14,5"
                            FontSize="11"
                            VerticalAlignment="Center"
                            ToolTip="{ui:UiText Dragonwilds.AllWorldInfoTooltip}" />
                </WrapPanel>
            </StackPanel>

            <!-- Idle: Play (host) and Join. Busy: the arcane loader and what is happening right now. -->
            <ContentControl Grid.Column="2" Content="{Binding}" Focusable="False" VerticalAlignment="Center" Width="300">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel>
                                        <Button Content="{ui:SpacedText Dragonwilds.Play}"
                                                Command="{Binding StartGameCommand}"
                                                Style="{DynamicResource DwPlayButton}"
                                                ToolTip="{ui:UiText Dragonwilds.PlayTooltip}" />
                                        <Button Content="{ui:SpacedText Dragonwilds.Join}"
                                                Command="{Binding JoinGameCommand}"
                                                Style="{DynamicResource DwButton}"
                                                Margin="0,10,0,0"
                                                ToolTip="{ui:UiText Dragonwilds.JoinTooltip}" />
                                        <TextBlock Text="{Binding PlayHintText}"
                                                   Style="{DynamicResource DwMuted}"
                                                   TextTrimming="None"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   FontSize="11.5"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{DynamicResource DwArcaneLoaderTemplate}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontFamily="{DynamicResource AppDisplayFontFamily}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource DwGoldBrightBrush}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Margin="0,10,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </ContentControl>
</UserControl>
