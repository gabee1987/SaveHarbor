<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsSharingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding CloudStateText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{Binding CloudDetailText}" Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Style="{DynamicResource DwMuted}"
                       Margin="0,6,0,0"
                       Visibility="{Binding IsCloudConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Run Text="{Binding CloudLatestVersionText, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding CloudLocalBaseText, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,16,0,0">
            <Button Content="{ui:UiText Actions.Connect}"
                    Command="{Binding ConnectCloudCommand}"
                    Style="{DynamicResource DwPrimaryButton}"
                    Margin="0,0,8,8"
                    Visibility="{Binding IsCloudConnected, Converter={x:Static converters:InverseBooleanToVisibilityConverter.Instance}}"
                    ToolTip="{ui:UiText Actions.ConnectTooltip}" />
            <Button Content="{ui:UiText Actions.Check}"
                    Command="{Binding CheckCloudCommand}"
                    Style="{DynamicResource DwSecondaryButton}"
                    Margin="0,0,8,8"
                    ToolTip="{ui:UiText Actions.CheckTooltip}" />
            <Button Content="{ui:UiText Actions.Upload}"
                    Command="{Binding UploadCloudCommand}"
                    Style="{DynamicResource DwSecondaryButton}"
                    Margin="0,0,8,8"
                    ToolTip="{ui:UiText Actions.UploadTooltip}" />
            <Button Content="{ui:UiText Actions.Download}"
                    Command="{Binding DownloadCloudCommand}"
                    Style="{DynamicResource DwSecondaryButton}"
                    Margin="0,0,8,8"
                    ToolTip="{ui:UiText Actions.DownloadTooltip}" />
            <Button Content="{ui:UiText Actions.StartSession}"
                    Command="{Binding StartCloudSessionCommand}"
                    Style="{DynamicResource DwSecondaryButton}"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasSessionLock, Converter={x:Static converters:InverseBooleanToVisibilityConverter.Instance}}"
                    ToolTip="{ui:UiText Actions.StartSessionTooltip}" />
            <Button Content="{ui:UiText Actions.EndSession}"
                    Command="{Binding EndCloudSessionCommand}"
                    Style="{DynamicResource DwSecondaryButton}"
                    Margin="0,0,8,8"
                    Visibility="{Binding IsOwnSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="{ui:UiText Actions.EndSessionTooltip}" />
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Style="{DynamicResource DwMuted}" FontSize="11.5" VerticalAlignment="Center" ToolTip="{Binding CloudAccountText}">
                <Run Text="{Binding CloudProviderText, Mode=OneWay}" />
            </TextBlock>
            <Button Content="{ui:UiText Dragonwilds.ChangeFolder}"
                    Command="{Binding SetupCloudFolderCommand}"
                    Style="{DynamicResource DwLinkButton}"
                    FontSize="11.5"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="{ui:UiText Actions.SetupCloudTooltip}" />
        </StackPanel>
    </Grid>
</UserControl>
