<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsSharingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
             xmlns:vm="clr-namespace:SaveHarbor.App.ViewModels"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <UserControl.Resources>
        <!-- One side of the comparison: which version, what happened since, and when. New progress is highlighted. -->
        <DataTemplate x:Key="SyncSideTemplate" DataType="{x:Type vm:SyncSide}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding Version}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource DwGoldTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNews}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding When}" Style="{DynamicResource DwMuted}" FontSize="11.5" Margin="0,1,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Corner ribbon on the side that holds the newer copy. -->
        <Style x:Key="NewerRibbon" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{DynamicResource DwGoldFillBrush}" Padding="6,1" Margin="0,-2,-3,0">
                            <TextBlock Text="{ui:SpacedText Dragonwilds.Newer}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- No world selected yet: the plain cloud status. -->
            <StackPanel Visibility="{Binding SelectedSyncAdvice, Converter={x:Static converters:NullToVisibleConverter.Instance}}">
                <TextBlock Text="{Binding CloudStateText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="{Binding CloudDetailText}" Style="{DynamicResource DwMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- What to do now, with the one action that resolves it. -->
            <ContentControl Content="{Binding SelectedSyncAdvice}" Style="{DynamicResource DwOptionalContent}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:SyncAdvice}">
                        <Border Style="{DynamicResource DwToneBorder}" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Headline}" Style="{DynamicResource DwToneText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource InkBrush}" Opacity="0.85" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding ActionLabel, Converter={x:Static converters:SpacedCapsConverter.Instance}}"
                                        Command="{Binding DataContext.RunRecommendedSyncActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{DynamicResource DwButton}"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="{ui:UiText Dragonwilds.RecommendedActionTooltip}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- This PC versus the cloud, side by side. The medallion between them says how they relate; the side with
                 the newer copy glows and carries a NEWER ribbon. -->
            <Grid Margin="0,14,0,0" Visibility="{Binding LocalSide, Converter={x:Static converters:NullToCollapsedConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{DynamicResource DwGlowLineBrush}" />

                <Border Style="{DynamicResource DwSideCard}" Tag="{Binding SelectedSyncAdvice.LocalIsNewer, FallbackValue=False}" ToolTip="{ui:UiText Dragonwilds.ThisPcTooltip}">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource DwPcGeometry}" Stroke="{DynamicResource DwGoldBrush}" StrokeThickness="1.2" Width="16" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{ui:SpacedText Dragonwilds.ThisPc}" Style="{DynamicResource DwLabel}" FontFamily="{DynamicResource AppDisplayFontFamily}" VerticalAlignment="Center" Margin="7,0,0,0" />
                            </StackPanel>
                            <ContentControl Content="{Binding LocalSide}" ContentTemplate="{StaticResource SyncSideTemplate}" Focusable="False" />
                            <Button Content="{ui:UiText Dragonwilds.RemoveFromPc}"
                                    Command="{Binding RemoveLocalWorldCommand}"
                                    Style="{DynamicResource DwDangerLink}"
                                    HorizontalAlignment="Left"
                                    Margin="0,9,0,0"
                                    ToolTip="{ui:UiText Dragonwilds.RemoveFromPcTooltip}" />
                        </StackPanel>
                        <ContentControl Style="{StaticResource NewerRibbon}"
                                        Visibility="{Binding SelectedSyncAdvice.LocalIsNewer, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </Grid>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding SelectedSyncAdvice}" Style="{DynamicResource DwOptionalContent}" VerticalAlignment="Center" ToolTip="{ui:UiText Dragonwilds.DirectionTooltip}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:SyncAdvice}">
                            <StackPanel>
                                <Border Style="{DynamicResource DwToneBorder}" Width="46" Height="46" CornerRadius="23" BorderThickness="1.5" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Direction}" Style="{DynamicResource DwToneText}" FontFamily="Segoe UI Symbol" FontSize="21"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                </Border>
                                <TextBlock Text="{Binding Relation}" Style="{DynamicResource DwToneText}" FontSize="10.5" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="2,6,2,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <Border Grid.Column="2" Style="{DynamicResource DwSideCard}" Tag="{Binding SelectedSyncAdvice.CloudIsNewer, FallbackValue=False}" ToolTip="{ui:UiText Header.LatestTooltip}">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource DwCloudGeometry}" Stroke="{DynamicResource DwGoldBrush}" StrokeThickness="1.2" Width="17" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{ui:SpacedText Dragonwilds.InTheCloud}" Style="{DynamicResource DwLabel}" FontFamily="{DynamicResource AppDisplayFontFamily}" VerticalAlignment="Center" Margin="7,0,0,0" />
                            </StackPanel>
                            <ContentControl Content="{Binding CloudSide}" ContentTemplate="{StaticResource SyncSideTemplate}" Focusable="False" />
                            <Button Content="{ui:UiText Dragonwilds.RemoveFromCloud}"
                                    Command="{Binding RemoveCloudWorldCommand}"
                                    Style="{DynamicResource DwDangerLink}"
                                    HorizontalAlignment="Left"
                                    Margin="0,9,0,0"
                                    Visibility="{Binding CanRemoveSelectedFromCloud, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{ui:UiText Dragonwilds.RemoveFromCloudTooltip}" />
                        </StackPanel>
                        <ContentControl Style="{StaticResource NewerRibbon}"
                                        Visibility="{Binding SelectedSyncAdvice.CloudIsNewer, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Margin="0,8,0,0"
                       Style="{DynamicResource DwMuted}"
                       FontSize="11.5"
                       ToolTip="{Binding CloudSessionTooltip}"
                       Visibility="{Binding HasSessionLock, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Run Text="{ui:UiText Dragonwilds.Host}" />
                <Run Text=": " />
                <Run Text="{Binding CloudSessionText, Mode=OneWay}" Foreground="{DynamicResource InkBrush}" />
            </TextBlock>

            <WrapPanel Margin="0,14,0,0">
                <Button Content="{ui:SpacedText Actions.Connect}"
                        Command="{Binding ConnectCloudCommand}"
                        Style="{DynamicResource DwButton}"
                        Margin="0,0,8,8"
                        Visibility="{Binding IsCloudConnected, Converter={x:Static converters:InverseBooleanToVisibilityConverter.Instance}}"
                        ToolTip="{ui:UiText Actions.ConnectTooltip}" />
                <Button Content="{ui:SpacedText Actions.Check}"
                        Command="{Binding CheckCloudCommand}"
                        Style="{DynamicResource DwButton}"
                        Margin="0,0,8,8"
                        ToolTip="{ui:UiText Actions.CheckTooltip}" />
                <Button Content="{ui:SpacedText Actions.Upload}"
                        Command="{Binding UploadCloudCommand}"
                        Style="{DynamicResource DwButton}"
                        Margin="0,0,8,8"
                        ToolTip="{ui:UiText Actions.UploadTooltip}" />
                <Button Content="{ui:SpacedText Actions.Download}"
                        Command="{Binding DownloadCloudCommand}"
                        Style="{DynamicResource DwButton}"
                        Margin="0,0,8,8"
                        ToolTip="{ui:UiText Actions.DownloadTooltip}" />
                <Button Content="{ui:SpacedText Actions.StartSession}"
                        Command="{Binding StartCloudSessionCommand}"
                        Style="{DynamicResource DwButton}"
                        Margin="0,0,8,8"
                        Visibility="{Binding HasSessionLock, Converter={x:Static converters:InverseBooleanToVisibilityConverter.Instance}}"
                        ToolTip="{ui:UiText Actions.StartSessionTooltip}" />
                <Button Content="{ui:SpacedText Actions.EndSession}"
                        Command="{Binding EndCloudSessionCommand}"
                        Style="{DynamicResource DwButton}"
                        Margin="0,0,8,8"
                        Visibility="{Binding IsOwnSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="{ui:UiText Actions.EndSessionTooltip}" />
            </WrapPanel>

            <Button Content="{ui:UiText Dragonwilds.ChangeFolder}"
                    Command="{Binding SetupCloudFolderCommand}"
                    Style="{DynamicResource DwLinkButton}"
                    HorizontalAlignment="Left"
                    FontSize="11.5"
                    Margin="0,2,0,0"
                    ToolTip="{ui:UiText Actions.SetupCloudTooltip}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
