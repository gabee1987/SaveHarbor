<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <!-- Bottom bar in the style of the game's menus: a glowing rule, who you are on the left, Settings on the right. -->
    <StackPanel Margin="0,16,0,0">
        <Rectangle Height="1" Fill="{DynamicResource DwGlowLineBrush}" />
        <Grid Margin="0,10,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{DynamicResource DwMuted}" VerticalAlignment="Center">
                <Run Text="{ui:UiText Dragonwilds.PlayingAs}" />
                <Run Text="{Binding PlayerDisplayName, Mode=OneWay}" Foreground="{DynamicResource InkBrush}" />
                <Run Text="  ·  " />
                <Run Text="{Binding CloudProviderText, Mode=OneWay}" />
            </TextBlock>
            <Button Grid.Column="1"
                    Content="{ui:SpacedText Dragonwilds.Settings}"
                    Command="{Binding OpenSettingsCommand}"
                    Style="{DynamicResource DwButton}"
                    MinHeight="30"
                    Padding="14,3"
                    ToolTip="{ui:UiText Dragonwilds.SettingsTooltip}" />
        </Grid>
    </StackPanel>
</UserControl>
