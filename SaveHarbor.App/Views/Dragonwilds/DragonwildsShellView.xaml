<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SaveHarbor.App.Views.Dragonwilds"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SaveHarbor.App;component/Resources/Themes/Dragonwilds/Dragonwilds.Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,0,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:DragonwildsHeaderView />

        <ContentControl Grid.Row="1" Style="{StaticResource DwOrnamentDivider}" Margin="0,10,0,20">
            <Ellipse Width="6" Height="6" Stroke="{StaticResource DwGoldBrush}" StrokeThickness="1" />
        </ContentControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:DragonwildsWorldListView />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:DragonwildsHeroView />

                <!-- Decorative only: fills the free space below the panels instead of stretching them. -->
                <Path Grid.Row="3"
                      Data="{StaticResource DwEmblemGeometry}"
                      Stroke="{StaticResource DwGoldBrush}"
                      StrokeThickness="1"
                      Stretch="Uniform"
                      MaxWidth="260"
                      MaxHeight="260"
                      Margin="0,24,0,0"
                      Opacity="0.08"
                      IsHitTestVisible="False" />

                <ContentControl Grid.Row="2" Style="{StaticResource DwFrame}" Padding="20,14,20,16">
                    <TabControl Style="{StaticResource DwTabControl}" ItemContainerStyle="{StaticResource DwTabItem}" MinHeight="170">
                        <TabItem Header="{ui:UiText Dragonwilds.TabSharing}">
                            <local:DragonwildsSharingView />
                        </TabItem>
                        <TabItem Header="{ui:UiText Dragonwilds.TabBackups}">
                            <local:DragonwildsBackupsView />
                        </TabItem>
                        <TabItem Header="{ui:UiText Dragonwilds.TabChronicle}">
                            <local:DragonwildsChronicleView />
                        </TabItem>
                    </TabControl>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
