<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsWorldListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
             xmlns:domain="clr-namespace:SaveHarbor.App.Domain"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <ContentControl Style="{DynamicResource DwFrame}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Style="{DynamicResource DwPanelHeading}" Content="{ui:SpacedText Dragonwilds.Worlds}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,10,0,0">
                <Button Content="{ui:UiText World.Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{DynamicResource DwLinkButton}"
                        Margin="0,0,16,0"
                        ToolTip="{ui:UiText World.RefreshTooltip}" />
                <Button Content="{ui:UiText World.OpenFolder}"
                        Command="{Binding OpenWorldFolderCommand}"
                        Style="{DynamicResource DwLinkButton}"
                        ToolTip="{Binding LocalSaveRoot}" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Worlds}"
                     SelectedItem="{Binding SelectedWorld}"
                     ItemContainerStyle="{DynamicResource DwWorldItem}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type domain:GameWorld}">
                        <StackPanel>
                            <TextBlock Text="{Binding WorldName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{DynamicResource DwMuted}" FontSize="11.5" Margin="0,3,0,0">
                                <Run Text="{Binding LastModifiedAt, Mode=OneWay, Converter={x:Static converters:RelativeAgeConverter.Instance}}" />
                                <Run Text=" · " />
                                <Run Text="{Binding SizeBytes, Mode=OneWay, Converter={x:Static converters:ByteSizeConverter.Instance}}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1"
                       Text="{ui:UiText Dragonwilds.NoWorlds}"
                       Style="{DynamicResource DwMuted}"
                       TextTrimming="None"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Margin="2,4,2,0">
                <TextBlock.Visibility>
                    <Binding Path="Worlds.Count" Converter="{x:Static converters:ZeroToVisibleConverter.Instance}" />
                </TextBlock.Visibility>
            </TextBlock>
        </Grid>
    </ContentControl>
</UserControl>
