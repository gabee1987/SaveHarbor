<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsBackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
             xmlns:domain="clr-namespace:SaveHarbor.App.Domain"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding BackupStorageSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{Binding LatestBackupDetails}"
                       Style="{DynamicResource DwMuted}"
                       Margin="0,4,0,0"
                       ToolTip="{Binding LatestBackupFileName}" />
        </StackPanel>

        <!-- Shown only while it matters: save operations are blocked while the game runs. -->
        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12,8"
                CornerRadius="3"
                BorderThickness="1"
                Background="{DynamicResource ToneWarnBackgroundBrush}"
                BorderBrush="{DynamicResource ToneWarnBorderBrush}"
                Visibility="{Binding IsGameRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding SafetyHint}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="{ui:SpacedText Dragonwilds.BackUpNow}"
                    Command="{Binding CreateBackupCommand}"
                    Style="{DynamicResource DwButton}"
                    Margin="0,0,8,8"
                    ToolTip="{ui:UiText Actions.BackupTooltip}" />
            <Button Content="{ui:SpacedText Dragonwilds.Restore}"
                    Command="{Binding RestoreBackupCommand}"
                    Style="{DynamicResource DwButton}"
                    Margin="0,0,8,8"
                    ToolTip="{ui:UiText Actions.RestoreTooltip}" />
            <Button Content="{ui:SpacedText Dragonwilds.Import}"
                    Command="{Binding ImportBackupCommand}"
                    Style="{DynamicResource DwButton}"
                    Margin="0,0,8,8"
                    ToolTip="{ui:UiText Actions.ImportTooltip}" />
            <Button Content="{ui:UiText Dragonwilds.OpenBackups}"
                    Command="{Binding OpenBackupFolderCommand}"
                    Style="{DynamicResource DwLinkButton}"
                    Margin="6,0,0,8"
                    VerticalAlignment="Center"
                    ToolTip="{Binding BackupRoot}" />
        </WrapPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{ui:SpacedText Dragonwilds.RecentBackups}" Style="{DynamicResource DwLabel}" FontFamily="{DynamicResource AppDisplayFontFamily}" Margin="0,0,0,8" />
            <TextBlock Text="{ui:UiText Dragonwilds.NoWorldBackups}"
                       Style="{DynamicResource DwMuted}"
                       TextTrimming="None"
                       TextWrapping="Wrap"
                       Visibility="{Binding SelectedWorldBackups.Count, Converter={x:Static converters:ZeroToVisibleConverter.Instance}}" />
            <ItemsControl ItemsSource="{Binding SelectedWorldBackups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type domain:WorldBackupItem}">
                        <Border BorderBrush="{DynamicResource DwFrameInnerBrush}" BorderThickness="0,0,0,1" Padding="0,6" ToolTip="{Binding FilePath}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CreatedAt, Converter={x:Static converters:RelativeAgeConverter.Instance}}" Style="{DynamicResource DwMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding Reason}" Foreground="{DynamicResource InkBrush}" FontSize="12.5" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={x:Static converters:ByteSizeConverter.Instance}}" Style="{DynamicResource DwMuted}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
