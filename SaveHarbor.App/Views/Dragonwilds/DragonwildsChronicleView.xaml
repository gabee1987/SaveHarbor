<UserControl x:Class="SaveHarbor.App.Views.Dragonwilds.DragonwildsChronicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
             xmlns:domain="clr-namespace:SaveHarbor.App.Domain"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300">
            <ItemsControl ItemsSource="{Binding Activity}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type domain:ActivityLogItem}">
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Width="7" Height="7" Margin="0,5,0,0" VerticalAlignment="Top">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{DynamicResource SubtleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                                <Setter Property="Fill" Value="{DynamicResource InfoBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                       Style="{DynamicResource DwMuted}"
                                       FontSize="11.5" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource InkBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="{ui:UiText Dragonwilds.NoActivity}"
                   Style="{DynamicResource DwMuted}"
                   Visibility="{Binding Activity.Count, Converter={x:Static converters:ZeroToVisibleConverter.Instance}}" />
    </Grid>
</UserControl>
