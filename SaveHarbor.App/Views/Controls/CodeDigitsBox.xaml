<!-- The 6-digit sign-in code as six boxes. One hidden text box takes the typing and pasting; the boxes only show it. -->
<UserControl x:Class="SaveHarbor.App.Views.Controls.CodeDigitsBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SaveHarbor.App.Views.Controls"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization"
             Focusable="False">
    <Grid>
        <ItemsControl x:Name="Cells" Focusable="False" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type controls:CodeDigitCell}">
                    <Border x:Name="Cell" Width="50" Height="60" Margin="5,0" CornerRadius="6" BorderThickness="1.5"
                            Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource SkinRowBorderBrush}">
                        <TextBlock Text="{Binding Digit}" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFilled}" Value="True">
                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource SkinGoldBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Covers the boxes so a click anywhere focuses it; its own text and caret stay invisible. -->
        <TextBox x:Name="Input" MaxLength="6" Background="Transparent" BorderThickness="0" Foreground="Transparent" CaretBrush="Transparent"
                 SelectionBrush="Transparent" Cursor="IBeam" AutomationProperties.Name="{ui:UiText Sharing.CodeLabel}" InputMethod.IsInputMethodEnabled="False"
                 PreviewTextInput="Input_PreviewTextInput" TextChanged="Input_TextChanged"
                 GotKeyboardFocus="Input_FocusChanged" LostKeyboardFocus="Input_FocusChanged" />
    </Grid>
</UserControl>
