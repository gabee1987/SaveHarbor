<UserControl x:Class="SaveHarbor.App.Views.Controls.ToastHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:SaveHarbor.App.Domain"
             xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <UserControl.Resources>
        <Style x:Key="ToastCloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Width="22" Height="22">
                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Newest toast at the bottom, nearest the corner. -->
    <StackPanel>
        <Button Content="{ui:UiText Toast.DismissAll}"
                Command="{Binding DismissAllToastsCommand}"
                HorizontalAlignment="Right"
                Margin="0,0,2,6"
                Cursor="Hand"
                Visibility="{Binding HasSeveralToasts, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10,3">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <ItemsControl ItemsSource="{Binding Toasts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type domain:ToastNotification}">
                    <Border x:Name="ToastCard"
                            Width="380"
                            Margin="0,0,0,8"
                            Padding="12,10,8,0"
                            MouseEnter="Toast_MouseEnter"
                            MouseLeave="Toast_MouseLeave"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Opacity="0"
                            RenderTransformOrigin="1,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="34" />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Name="ToastOpenStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1"
                                                                 Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                 To="0"
                                                                 Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <DataTrigger Binding="{Binding IsClosing}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="ToastOpenStoryboard" />
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1"
                                                                     To="0"
                                                                     Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                     From="0"
                                                                     To="90"
                                                                     Duration="0:0:0.38">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static domain:ToastKind.Success}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static domain:ToastKind.Warning}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static domain:ToastKind.Error}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Width="8"
                                    Margin="0,0,0,10"
                                    CornerRadius="4"
                                    Background="{DynamicResource AccentBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static domain:ToastKind.Success}">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static domain:ToastKind.Warning}">
                                                <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static domain:ToastKind.Error}">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Style="{StaticResource ToastCloseButton}"
                                    VerticalAlignment="Top"
                                    Margin="6,-4,0,0"
                                    ToolTip="{ui:UiText Toast.Close}"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />

                            <!-- Time left: a small magic spark drifts from right to left along a fading thread, trailing light
                                 where it has just been. It rests while the pointer is on the toast. -->
                            <Grid x:Name="TimeTrack"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="4"
                                  Height="11"
                                  Margin="-12,0,-8,-1"
                                  VerticalAlignment="Bottom"
                                  ClipToBounds="True"
                                  IsHitTestVisible="False">
                                <Border Height="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Background="{Binding BorderBrush, ElementName=ToastCard}"
                                        Opacity="0.35">
                                    <Border.Width>
                                        <MultiBinding Converter="{x:Static converters:FractionOfWidthConverter.Instance}">
                                            <Binding Path="RemainingFraction" />
                                            <Binding Path="ActualWidth" ElementName="TimeTrack" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                <Canvas>
                                    <Grid Height="11" Width="48">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{x:Static converters:FractionOfWidthConverter.Instance}" ConverterParameter="-5.5">
                                                <Binding Path="RemainingFraction" />
                                                <Binding Path="ActualWidth" ElementName="TimeTrack" />
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SparkGlow"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0.5" To="1" Duration="0:0:0.45"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetName="SparkScale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         From="0.75" To="1.2" Duration="0:0:0.7"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                        <DoubleAnimation Storyboard.TargetName="SparkScale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         From="0.75" To="1.2" Duration="0:0:0.7"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                        <Rectangle Height="1.5"
                                                   Width="40"
                                                   HorizontalAlignment="Left"
                                                   Margin="5.5,0,0,0"
                                                   Fill="{Binding BorderBrush, ElementName=ToastCard}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0" Color="#D0000000" />
                                                    <GradientStop Offset="1" Color="#00000000" />
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Ellipse x:Name="SparkGlow"
                                                 Width="11"
                                                 Height="11"
                                                 HorizontalAlignment="Left"
                                                 RenderTransformOrigin="0.5,0.5"
                                                 Fill="{Binding BorderBrush, ElementName=ToastCard}">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="SparkScale" />
                                            </Ellipse.RenderTransform>
                                            <Ellipse.OpacityMask>
                                                <RadialGradientBrush>
                                                    <GradientStop Offset="0" Color="#FF000000" />
                                                    <GradientStop Offset="0.45" Color="#80000000" />
                                                    <GradientStop Offset="1" Color="#00000000" />
                                                </RadialGradientBrush>
                                            </Ellipse.OpacityMask>
                                        </Ellipse>
                                        <Ellipse Width="2.6"
                                                 Height="2.6"
                                                 HorizontalAlignment="Left"
                                                 Margin="4.2,0,0,0"
                                                 Fill="#FFF8E7" />
                                    </Grid>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
