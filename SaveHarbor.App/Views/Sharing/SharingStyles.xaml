<!-- Shapes of the Sharing page of Settings, shared by its screens. Colours come only from the active game's theme and skin, so the
     page follows Windrose and Dragonwilds alike. Views reference these keys with DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A calm panel: one hairline, no inner rule. -->
    <Style x:Key="SharingCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkinRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <Style x:Key="SharingCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource SkinGoldBrightBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SharingText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="SharingHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="SharingFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- The big question of a sign-in step. -->
    <Style x:Key="SharingStepTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource SkinGoldTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SharingStepText" TargetType="TextBlock" BasedOn="{StaticResource SharingHint}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- A round initial: the player, a member, a group. Tag="True" rings it in bright gold (you, the owner). -->
    <Style x:Key="SharingAvatar" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SkinGoldBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SkinGoldBrightBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SharingAvatarText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SkinGoldTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A large choice ("Join friends", "SaveHarbor Cloud"): the whole card is the button. -->
    <Style x:Key="SharingChoiceCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource SkinRowBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="20,18">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SkinGoldBrightBrush}" />
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SkinSelectedRowBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SkinGoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One of the four sign-in step dots; Tag="True" for the steps reached. -->
    <Style x:Key="SharingStepDot" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Background" Value="{DynamicResource LineSoftBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SkinGoldBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A thin divider between parts of a card. -->
    <Style x:Key="SharingDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource LineSoftBrush}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>
</ResourceDictionary>
