<!-- Google Drive: the shared folder this game uses, and the player's own settings. DataContext: SharingViewModel. -->
<UserControl x:Class="SaveHarbor.App.Views.Sharing.SharingDriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sharing="clr-namespace:SaveHarbor.App.Views.Sharing"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{DynamicResource SharingCard}" BorderBrush="{DynamicResource SkinGoldBrush}">
                    <StackPanel>
                        <TextBlock Text="{ui:UiText Sharing.DriveFolderTitle}" Style="{DynamicResource SharingCardTitle}" />
                        <TextBlock Text="{Binding DriveFolderText}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="20"
                                   Foreground="{DynamicResource SkinGoldTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{ui:UiText Sharing.DriveFolderHint}" Style="{DynamicResource SharingHint}" Margin="0,8,0,0" />
                        <Button Content="{ui:SpacedText Sharing.DriveChangeFolder}" Command="{Binding ChangeDriveFolderCommand}" Style="{DynamicResource SkinButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource SharingCard}" Margin="0,16,0,0"
                        Visibility="{Binding CanSwitchToCloud, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{ui:UiText Sharing.TryCloudTitle}" Style="{DynamicResource SharingCardTitle}" />
                        <TextBlock Text="{ui:UiText CloudProviderChoice.SupabaseDescription}" Style="{DynamicResource SharingHint}" />
                        <Button Content="{ui:UiText Sharing.UseCloudInstead}" Command="{Binding SwitchProviderCommand}" CommandParameter="Supabase"
                                Style="{DynamicResource SkinLinkButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <sharing:SharingProfileCard Grid.Column="2" />
        </Grid>
    </ScrollViewer>
</UserControl>
