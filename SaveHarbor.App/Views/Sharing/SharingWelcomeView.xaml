<!-- First start: how the group shares its worlds, as two large cards. -->
<UserControl x:Class="SaveHarbor.App.Views.Sharing.SharingWelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <UserControl.Resources>
        <!-- A point of a card, with a small diamond. -->
        <Style x:Key="Point" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="PointRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
        <Style x:Key="PointMark" TargetType="Path">
            <Setter Property="Data" Value="{DynamicResource SkinDiamondGeometry}" />
            <Setter Property="Fill" Value="{DynamicResource SkinGoldBrush}" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid VerticalAlignment="Center" MaxWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Style="{DynamicResource SharingChoiceCard}" Command="{Binding ChooseProviderCommand}" CommandParameter="Supabase"
                    AutomationProperties.Name="{ui:UiText CloudProviderChoice.SupabaseTitle}"
                    Visibility="{Binding IsCloudAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Path Data="{DynamicResource SkinCloudGeometry}" Stroke="{DynamicResource SkinGoldBrightBrush}" StrokeThickness="1.4"
                              Width="44" Height="30" Stretch="Uniform" HorizontalAlignment="Left" />
                        <Border Style="{DynamicResource SkinPill}" HorizontalAlignment="Right" BorderBrush="{DynamicResource SkinGoldBrush}" Margin="0">
                            <TextBlock Text="{ui:UiText CloudProviderChoice.Recommended}" Foreground="{DynamicResource SkinGoldBrightBrush}" FontSize="11.5" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{ui:UiText CloudProviderChoice.SupabaseTitle}" Style="{DynamicResource SharingCardTitle}" FontSize="22" Margin="0,14,0,6" />
                    <TextBlock Text="{ui:UiText CloudProviderChoice.SupabaseDescription}" Style="{DynamicResource SharingHint}" />
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Style="{StaticResource PointRow}"><Path Style="{StaticResource PointMark}" /><TextBlock Text="{ui:UiText Sharing.CloudPointSignIn}" Style="{StaticResource Point}" /></StackPanel>
                        <StackPanel Style="{StaticResource PointRow}"><Path Style="{StaticResource PointMark}" /><TextBlock Text="{ui:UiText Sharing.CloudPointPlaying}" Style="{StaticResource Point}" /></StackPanel>
                        <StackPanel Style="{StaticResource PointRow}"><Path Style="{StaticResource PointMark}" /><TextBlock Text="{ui:UiText Sharing.CloudPointNoAccount}" Style="{StaticResource Point}" /></StackPanel>
                    </StackPanel>
                    <TextBlock Text="{ui:UiText Sharing.UseCloud}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="14"
                               Foreground="{DynamicResource SkinGoldBrightBrush}" Margin="0,18,0,0" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{DynamicResource SharingChoiceCard}" Command="{Binding ChooseProviderCommand}" CommandParameter="GoogleDrive"
                    AutomationProperties.Name="{ui:UiText CloudProviderChoice.GoogleDriveTitle}"
                    Visibility="{Binding IsDriveAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Path Data="{DynamicResource SkinPcGeometry}" Stroke="{DynamicResource SkinGoldBrush}" StrokeThickness="1.4"
                          Width="40" Height="30" Stretch="Uniform" HorizontalAlignment="Left" />
                    <TextBlock Text="{ui:UiText CloudProviderChoice.GoogleDriveTitle}" Style="{DynamicResource SharingCardTitle}" FontSize="22" Margin="0,14,0,6" />
                    <TextBlock Text="{ui:UiText CloudProviderChoice.GoogleDriveDescription}" Style="{DynamicResource SharingHint}" />
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Style="{StaticResource PointRow}"><Path Style="{StaticResource PointMark}" /><TextBlock Text="{ui:UiText Sharing.DrivePointFolder}" Style="{StaticResource Point}" /></StackPanel>
                        <StackPanel Style="{StaticResource PointRow}"><Path Style="{StaticResource PointMark}" /><TextBlock Text="{ui:UiText Sharing.DrivePointAccount}" Style="{StaticResource Point}" /></StackPanel>
                    </StackPanel>
                    <TextBlock Text="{ui:UiText Sharing.UseDrive}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="14"
                               Foreground="{DynamicResource SkinGoldBrightBrush}" Margin="0,18,0,0" />
                </StackPanel>
            </Button>

            <!-- Where each choice keeps the worlds, before anything is chosen. -->
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{ui:UiText Settings.ProviderHint}" Style="{DynamicResource SharingHint}"
                       TextAlignment="Center" Margin="0,16,0,0" />

            <Button Grid.Row="2" Grid.ColumnSpan="3" Content="{ui:UiText CloudProviderChoice.Later}" Command="{Binding DecideLaterCommand}"
                    Style="{DynamicResource SkinLinkButton}" HorizontalAlignment="Center" Margin="0,14,0,0" />
        </Grid>
    </ScrollViewer>
</UserControl>
