<Window x:Class="SaveHarbor.App.Views.Shell.WorldInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SaveHarbor.App.Views.Behaviors"
        xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
        xmlns:domain="clr-namespace:SaveHarbor.App.Domain"
        xmlns:ui="clr-namespace:SaveHarbor.App.Localization"
        Title="{Binding WorldName, StringFormat=All world info · {0}}"
        Width="980"
        Height="780"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <!-- The active game's skin is merged in code (see the constructor). -->

            <!-- Values are selectable, so a path or hash can be copied. -->
            <Style x:Key="InspectorValue" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource SkinGoldBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <ContentPresenter Content="{Binding}" ContentTemplate="{DynamicResource SkinSmokeTemplate}" />

        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{ui:SpacedText Inspector.Title}" Style="{DynamicResource SkinLabel}" FontFamily="{DynamicResource AppDisplayFontFamily}" />
                    <TextBlock Text="{Binding WorldName}"
                               FontFamily="{DynamicResource AppDisplayFontFamily}"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SkinGoldTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding PrivacyNote}" Style="{DynamicResource SkinMuted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{ui:SpacedText Inspector.ShowFile}" Command="{Binding ShowWorldFileCommand}" Style="{DynamicResource SkinButton}"
                            Margin="0,0,8,0" ToolTip="{ui:UiText Inspector.ShowFileTooltip}" />
                    <Button Content="{ui:SpacedText Inspector.SaveFolder}" Command="{Binding OpenSaveFolderCommand}" Style="{DynamicResource SkinButton}"
                            Margin="0,0,8,0" ToolTip="{ui:UiText Shell.OpenSaveFolder}" />
                    <Button Content="{ui:SpacedText Inspector.Backups}" Command="{Binding OpenBackupFolderCommand}" Style="{DynamicResource SkinButton}"
                            ToolTip="{ui:UiText Shell.OpenBackups}" />
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1" Style="{DynamicResource SkinOrnamentDivider}" Margin="0,16,0,14" />

            <StackPanel Grid.Row="2">
                <!-- Offered only when the save checks found something; the details are in the Save health section. -->
                <Border Margin="0,0,0,14"
                        Padding="16,12"
                        CornerRadius="3"
                        BorderThickness="1"
                        Background="{DynamicResource SkinCardBrush}"
                        BorderBrush="{DynamicResource ToneWarnBorderBrush}"
                        Visibility="{Binding HasHealthProblems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{ui:UiText Inspector.HealthTitle}" Foreground="{DynamicResource WarnBrush}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{ui:UiText Inspector.HealthHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{ui:SpacedText Inspector.KeepWorld}" Command="{Binding KeepWorldAsItIsCommand}" Style="{DynamicResource SkinButton}"
                                    ToolTip="{ui:UiText Inspector.KeepWorldTooltip}"
                                    Visibility="{Binding IsWorldReplaced, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="{ui:SpacedText Inspector.MoveLeftovers}" Command="{Binding MoveLeftoversAsideCommand}" Style="{DynamicResource SkinButton}"
                                    Margin="8,0,0,0" ToolTip="{ui:UiText Inspector.MoveLeftoversTooltip}"
                                    Visibility="{Binding HasLeftovers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Offered only when the game has written its own backup copy of this world. -->
                <Border Margin="0,0,0,14"
                        Padding="16,12"
                        CornerRadius="3"
                        BorderThickness="1"
                        Background="{DynamicResource SkinCardBrush}"
                        BorderBrush="{DynamicResource SkinFrameBrush}"
                        Visibility="{Binding GameBackupCopyPath, Converter={x:Static converters:NullToCollapsedConverter.Instance}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{ui:UiText Inspector.GameCopyTitle}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{ui:UiText Inspector.GameCopyHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{ui:UiText Inspector.ShowGameCopy}" Command="{Binding ShowGameBackupCopyCommand}" Style="{DynamicResource SkinLinkButton}"
                                    Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="{Binding GameBackupCopyPath}" />
                            <Button Content="{ui:SpacedText Inspector.UseGameCopy}" Command="{Binding UseGameBackupCopyCommand}" Style="{DynamicResource SkinButton}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <ContentControl Grid.Row="3" Style="{DynamicResource SkinFrame}" Padding="22,16">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type domain:InspectionSection}">
                                    <StackPanel Margin="0,0,0,10">
                                        <ContentControl Style="{DynamicResource SkinPanelHeading}" Content="{Binding Title, Converter={x:Static converters:SpacedCapsConverter.Instance}}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type domain:InspectionItem}">
                                                    <Border BorderBrush="{DynamicResource SkinFrameInnerBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="240" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Style="{DynamicResource SkinMuted}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Label}" Margin="0,0,12,0" />
                                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource InspectorValue}" />
                                                            <Button Grid.Column="2" Style="{DynamicResource SkinCopyButton}" VerticalAlignment="Top" Margin="8,-2,0,0"
                                                                    Command="{x:Static behaviors:ClipboardCommands.Copy}" CommandParameter="{Binding Value}" ToolTip="{ui:UiText Paths.CopyValueTooltip}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{DynamicResource SkinArcaneLoaderTemplate}" />
                        <TextBlock Text="{ui:UiText Inspector.Loading}" Style="{DynamicResource SkinMuted}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <Button Grid.Row="4"
                    Content="{ui:SpacedText Inspector.Close}"
                    Style="{DynamicResource SkinButton}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
