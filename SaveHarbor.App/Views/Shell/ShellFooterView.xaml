<UserControl x:Class="SaveHarbor.App.Views.Shell.ShellFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <!-- Bottom bar in the style of the game's menus: a glowing rule, who you are on the left, Settings on the right. -->
    <StackPanel Margin="0,16,0,0">
        <Rectangle Height="1" Fill="{DynamicResource SkinGlowLineBrush}" />
        <Grid Margin="0,10,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource SkinMuted}" VerticalAlignment="Center">
                    <Run Text="{ui:UiText Shell.PlayingAs}" />
                    <Run Text="{Binding PlayerDisplayName, Mode=OneWay}" Foreground="{DynamicResource InkBrush}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding CloudProviderText, Mode=OneWay}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding AppVersionText, Mode=OneWay}" />
                </TextBlock>
                <Button Content="{ui:UiText Shell.PatchNotes}"
                        Command="{Binding OpenPatchNotesCommand}"
                        Style="{DynamicResource SkinLinkButton}"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        ToolTip="{ui:UiText Shell.PatchNotesTooltip}" />
            </StackPanel>
            <Grid Grid.Column="1">
                <Button Content="{ui:SpacedText Shell.Settings}"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{DynamicResource SkinButton}"
                        MinHeight="30"
                        Padding="14,3"
                        ToolTip="{ui:UiText Shell.SettingsTooltip}" />
                <!-- An update waits ("Later" was chosen); it installs when SaveHarbor closes. -->
                <Ellipse Width="8" Height="8" Fill="{DynamicResource SkinGoldBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-3,-3,0" IsHitTestVisible="False"
                         Visibility="{Binding HasUpdateDot, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
