<UserControl x:Class="SaveHarbor.App.Views.Shell.ShellSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:SaveHarbor.App.Views.Behaviors"
             xmlns:converters="clr-namespace:SaveHarbor.App.Views.Converters"
             xmlns:ui="clr-namespace:SaveHarbor.App.Localization">
    <Grid>
        <Border Background="{DynamicResource SkinOverlayBrush}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}" />
            </Border.InputBindings>
        </Border>

        <ContentControl Style="{DynamicResource SkinFrame}"
                        BorderBrush="{DynamicResource SkinGoldBrush}"
                        Width="780"
                        MaxHeight="680"
                        Margin="24"
                        Padding="30,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl Style="{DynamicResource SkinPageHeading}" Content="{ui:SpacedText Shell.Settings}" FontSize="26" Margin="0,0,0,18" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>
                        <ContentControl Style="{DynamicResource SkinPanelHeading}" Content="{ui:SpacedText Settings.Player}" />
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.PlayerName}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0">
                                        <Run Text="{ui:UiText Settings.PlayerNameHint}" />
                                        <Run Text="{Binding Settings.EffectivePlayerName, Mode=OneWay}" Foreground="{DynamicResource SkinGoldBrightBrush}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{DynamicResource SkinTextBox}" MaxLength="32" VerticalAlignment="Center"
                                         Text="{Binding Settings.PlayerName, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                        </Border>

                        <ContentControl Style="{DynamicResource SkinPanelHeading}" Content="{ui:SpacedText Settings.Saves}" Margin="0,12,0,14" />
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Foreground="{DynamicResource InkBrush}" FontSize="13.5">
                                        <Run Text="{Binding Settings.GameName, Mode=OneWay}" />
                                        <Run Text="{ui:UiText Settings.SaveFolderSuffix}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Settings.SaveFolder}" Style="{DynamicResource SkinMuted}" Margin="0,3,0,0" ToolTip="{Binding Settings.SaveFolder}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource SkinCopyButton}" Command="{x:Static behaviors:ClipboardCommands.Copy}" CommandParameter="{Binding Settings.SaveFolder}" ToolTip="{ui:UiText Paths.CopyTooltip}" Margin="0,0,8,0" />
                                    <Button Content="{ui:SpacedText Settings.Reset}" Command="{Binding Settings.ResetSaveFolderCommand}" Style="{DynamicResource SkinButton}"
                                            Margin="0,0,8,0" ToolTip="{ui:UiText Settings.ResetTooltip}"
                                            Visibility="{Binding Settings.HasCustomSaveFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Content="{ui:SpacedText Settings.Open}" Command="{Binding Settings.OpenSaveFolderCommand}" Style="{DynamicResource SkinButton}"
                                            Margin="0,0,8,0" ToolTip="{ui:UiText Settings.OpenSaveFolderTooltip}" />
                                    <Button Content="{ui:SpacedText Settings.Browse}" Command="{Binding Settings.BrowseSaveFolderCommand}" Style="{DynamicResource SkinButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.BackupFolder}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{Binding Settings.BackupFolder}" Style="{DynamicResource SkinMuted}" Margin="0,3,0,0" ToolTip="{Binding Settings.BackupFolder}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource SkinCopyButton}" Command="{x:Static behaviors:ClipboardCommands.Copy}" CommandParameter="{Binding Settings.BackupFolder}" ToolTip="{ui:UiText Paths.CopyTooltip}" Margin="0,0,8,0" />
                                    <Button Content="{ui:SpacedText Settings.Open}" Command="{Binding Settings.OpenBackupFolderCommand}"
                                            Style="{DynamicResource SkinButton}" ToolTip="{ui:UiText Settings.BackupFolderTooltip}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.KeepBackups}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.KeepBackupsHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource SkinComboBox}"
                                          ItemsSource="{Binding Settings.RetentionOptions}"
                                          SelectedItem="{Binding Settings.SelectedRetention}" />
                            </Grid>
                        </Border>

                        <ContentControl Style="{DynamicResource SkinPanelHeading}" Content="{ui:SpacedText Settings.Sharing}" Margin="0,12,0,14" />
                        <Border Style="{DynamicResource SkinSettingRow}" Visibility="{Binding Settings.IsProviderChoiceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.Provider}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.ProviderHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource SkinComboBox}"
                                          AutomationProperties.Name="{ui:UiText Settings.Provider}"
                                          ItemsSource="{Binding Settings.ProviderChoices}"
                                          SelectedItem="{Binding Settings.SelectedProvider}" />
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding Settings.ShowGroupSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{DynamicResource SkinSettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{ui:UiText Settings.SignedInAs}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                        <TextBlock Text="{Binding Settings.SignedInText}" Style="{DynamicResource SkinMuted}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{ui:SpacedText Settings.SignOut}" Command="{Binding Settings.SignOutCommand}" Style="{DynamicResource SkinButton}"
                                            VerticalAlignment="Center" Visibility="{Binding Settings.IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource SkinSettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Foreground="{DynamicResource InkBrush}" FontSize="13.5">
                                            <Run Text="{ui:UiText Settings.GroupFor}" />
                                            <Run Text="{Binding Settings.GameName, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Settings.ActiveGroupName}" Style="{DynamicResource SkinMuted}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding Settings.ChangeGroupText, Converter={x:Static converters:SpacedCapsConverter.Instance}}" Command="{Binding Settings.ChangeGroupCommand}" Style="{DynamicResource SkinButton}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource SkinSettingRow}" Visibility="{Binding Settings.HasActiveGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{ui:UiText Settings.InviteCode}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                        <TextBlock Text="{ui:UiText Settings.InviteCodeOwnerHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Visibility="{Binding Settings.IsGroupOwner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{ui:UiText Settings.InviteCodeMemberHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Visibility="{Binding Settings.IsGroupMember, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Settings.InviteCode}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SkinGoldBrightBrush}" Margin="0,6,0,0"
                                                   Visibility="{Binding Settings.HasInviteCode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding Settings.IsGroupOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Style="{DynamicResource SkinCopyButton}" Command="{x:Static behaviors:ClipboardCommands.Copy}" CommandParameter="{Binding Settings.InviteCode}"
                                                ToolTip="{ui:UiText Settings.InviteCodeCopyTooltip}" Margin="0,0,8,0"
                                                Visibility="{Binding Settings.HasInviteCode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Content="{ui:SpacedText Settings.InviteCodeShow}" Command="{Binding Settings.ShowInviteCodeCommand}" Style="{DynamicResource SkinButton}" Margin="0,0,8,0"
                                                Visibility="{Binding Settings.HasInviteCode, Converter={x:Static converters:InverseBooleanToVisibilityConverter.Instance}}" />
                                        <Button Content="{ui:SpacedText Settings.InviteCodeRotate}" Command="{Binding Settings.RotateInviteCodeCommand}" Style="{DynamicResource SkinButton}"
                                                ToolTip="{ui:UiText Settings.InviteCodeRotateTooltip}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource SkinSettingRow}" Visibility="{Binding Settings.HasActiveGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Foreground="{DynamicResource InkBrush}" FontSize="13.5">
                                            <Run Text="{ui:UiText Settings.StorageUsed}" />
                                            <Run Text="{Binding Settings.StorageUsedText, Mode=OneWay}" Foreground="{DynamicResource SkinGoldBrightBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{ui:UiText Settings.StorageUsedHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{ui:SpacedText Settings.CleanUp}" Command="{Binding Settings.CleanUpUnusedFilesCommand}" Style="{DynamicResource SkinButton}"
                                            VerticalAlignment="Center" ToolTip="{ui:UiText Settings.CleanUpTooltip}" />
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource SkinSettingRow}" Visibility="{Binding Settings.HasActiveGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{ui:UiText Settings.LeaveGroup}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                        <TextBlock Text="{ui:UiText Settings.LeaveGroupHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{ui:UiText Settings.LeaveGroupButton}" Command="{Binding Settings.LeaveGroupCommand}" Style="{DynamicResource SkinDangerLink}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Style="{DynamicResource SkinSettingRow}" Visibility="{Binding Settings.ShowSharedFolderSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.SharedFolder}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.SharedFolderHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{ui:SpacedText Settings.Change}" Command="{Binding SetupCloudCommand}"
                                        Style="{DynamicResource SkinButton}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.DeviceLabel}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0">
                                        <Run Text="{ui:UiText Settings.DeviceLabelHint}" />
                                        <Run Text="{Binding Settings.EffectiveDeviceLabel, Mode=OneWay}" Foreground="{DynamicResource SkinGoldBrightBrush}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBox Grid.Column="1" Style="{DynamicResource SkinTextBox}" MaxLength="32" VerticalAlignment="Center"
                                         AutomationProperties.Name="{ui:UiText Settings.DeviceLabel}"
                                         Text="{Binding Settings.DeviceLabel, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.KeepSharedVersions}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.KeepSharedVersionsHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding Settings.ShowSharedFolderSettings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{ui:UiText Settings.KeepSharedVersionsHintCloud}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding Settings.ShowGroupSettings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource SkinComboBox}"
                                          ItemsSource="{Binding Settings.CloudRetentionOptions}"
                                          SelectedItem="{Binding Settings.SelectedCloudRetention}" />
                            </Grid>
                        </Border>

                        <ContentControl Style="{DynamicResource SkinPanelHeading}" Content="{ui:SpacedText Settings.Appearance}" Margin="0,12,0,14" />
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.AmbientEffects}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.AmbientEffectsHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{DynamicResource SkinToggle}" VerticalAlignment="Center" IsChecked="{Binding Settings.AmbientEffects}" />
                            </Grid>
                        </Border>

                        <ContentControl Style="{DynamicResource SkinPanelHeading}" Content="{ui:SpacedText Settings.Support}" Margin="0,12,0,14" />
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Foreground="{DynamicResource InkBrush}" FontSize="13.5">
                                        <Run Text="{ui:UiText Settings.AppVersion}" />
                                        <Run Text="{Binding AppVersionText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{ui:UiText Settings.UpdatesHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{ui:UiText Settings.UpdatesUnavailable}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding UpdatesUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{ui:SpacedText Settings.CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}"
                                        Style="{DynamicResource SkinButton}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource SkinSettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:UiText Settings.Troubleshooting}" Foreground="{DynamicResource InkBrush}" FontSize="13.5" />
                                    <TextBlock Text="{ui:UiText Settings.TroubleshootingHint}" Style="{DynamicResource SkinMuted}" TextTrimming="None" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{ui:SpacedText Settings.OpenLogs}" Command="{Binding Settings.OpenLogsFolderCommand}" Style="{DynamicResource SkinButton}" Margin="0,0,8,0" />
                                    <Button Content="{ui:SpacedText Settings.OpenData}" Command="{Binding Settings.OpenDataFolderCommand}" Style="{DynamicResource SkinButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="{ui:SpacedText Settings.Back}" Command="{Binding CloseSettingsCommand}" Style="{DynamicResource SkinButton}" />
                    <Border BorderBrush="{DynamicResource SkinParchmentBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ESC" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SkinParchmentBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
