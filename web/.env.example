# Copy to .env.local for a local build. Both are public values (the same ones the desktop app ships with);
# never put the service_role key or any secret key here.
# Local stack after `supabase start`: VITE_SUPABASE_URL=http://127.0.0.1:54321 and the publishable key it prints.
VITE_SUPABASE_URL=https://TEST_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TEST

# Who runs SaveHarbor, for the privacy and terms pages (scripts/fill-legal.mjs). Not used by the page's code; on main
# the repository variables of the same names are used. Empty: the pages keep their placeholders.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
